---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { layerLabel, countryLabel, tagLabel, productInfo } from '../lib/display';
import { getMetricState, formatMetricValue } from '../lib/metrics';
import facilities from '../data/facilities.json';
import sectorKpis from '../data/sector-kpis.json';
import sectorKpiDefinitions from '../data/sector-kpi-definitions.json';
import metricDefinitions from '../data/metric-definitions.json';
import roicCalculations from '../data/roic-calculations.json';

const companies = (await getCollection('companies')).sort((a,b) => a.data.name.localeCompare(b.data.name));
const kpisByCompany = new Map();
for (const kpi of sectorKpis) { const list = kpisByCompany.get(kpi.companyId) ?? []; list.push(kpi); kpisByCompany.set(kpi.companyId, list); }
const facilitiesByCompany = new Map();
for (const facility of facilities) { const list = facilitiesByCompany.get(facility.companyId) ?? []; list.push(facility); facilitiesByCompany.set(facility.companyId, list); }
const verifiedRoic = new Set(roicCalculations.filter(calc => calc.status === 'verified').map(calc => calc.companyId));
const compact = companies.map(c => ({
  id:c.id, name:c.data.name, japaneseName:c.data.japaneseName, ticker:c.data.ticker,
  country:countryLabel(c.data.country), primaryLayer:layerLabel(c.data.primaryLayer),
  products:c.data.products.map(product => productInfo(product).label), technologies:c.data.tags.map(tagLabel),
  facilities:(facilitiesByCompany.get(c.id) ?? []).map(site => `${site.city}（${site.region}）`),
  metrics:Object.fromEntries(Object.entries(c.data.metrics).map(([key, metric]) => [key, { ...metric, display:formatMetricValue(metric), state:getMetricState(c.id,key,metric,key === 'roic' && verifiedRoic.has(c.id)) }])),
  scores:c.data.scores ?? null,
  kpis:kpisByCompany.get(c.id) ?? []
}));
const definitions = Object.fromEntries(sectorKpiDefinitions.map(d => [d.id, d]));
const commonDefinitions = Object.fromEntries(metricDefinitions.map(d => [d.id, d]));
const defaults = ['nvidia','tsmc','asml','tokyo-electron',''];
---
<BaseLayout title="企業比較">
  <header class="page-head"><div class="shell"><span class="eyebrow">企業横断比較</span><h1>企業比較</h1><p class="lead">最大5社を横並びで比較します。財務数値は期間・定義・検証状態を併記し、欠損や比較条件の違いを隠しません。</p></div></header>
  <div class="shell section" id="compare-app">
    <p class="meta">主観評価は客観データと分離し、表の最下段に「分析」として表示します。未評価の企業は無理に点数を付けず「未評価」と表示します。</p>
    <div class="compare-picks">
      {[0,1,2,3,4].map((slot) => <label>比較企業 {slot+1}<select class="control compare-select" data-slot={slot}><option value="">— 未選択 —</option>{companies.map(c => <option value={c.id} selected={c.id === defaults[slot]}>{c.data.japaneseName || c.data.name} ({c.data.ticker})</option>)}</select></label>)}
    </div>
    <div class="table-scroll compare-scroll"><table class="compare-table" id="compare-table"><thead><tr id="compare-head"><th>指標</th></tr></thead><tbody></tbody></table></div>
    <script id="compare-data" type="application/json" set:html={JSON.stringify({ companies: compact, definitions, commonDefinitions })}></script>
  </div>
  <script is:inline>
    const root = document.querySelector('#compare-app');
    const dataNode = document.querySelector('#compare-data');
    if (root && dataNode) {
      const payload = JSON.parse(dataNode.textContent || '{}');
      const companies = payload.companies || [];
      const definitions = payload.definitions || {};
      const commonDefinitions = payload.commonDefinitions || {};
      const byId = new Map(companies.map(c => [c.id, c]));
      const selects = [...root.querySelectorAll('.compare-select')];
      const tbody = root.querySelector('#compare-table tbody');
      const theadRow = root.querySelector('#compare-head');
      const params = new URLSearchParams(location.search);
      const requested = (params.get('ids') || '').split(',').filter(Boolean).slice(0,5);
      requested.forEach((id,index) => { if (selects[index]) selects[index].value = id; });

      const metricText = metric => {
        if (!metric || metric.value == null) return metric?.state?.label || '未収録';
        const parts = [metric.display || String(metric.value), metric.period || '', `状態：${metric.state?.label || '要再検証'}`];
        return parts.filter(Boolean).join('\n');
      };
      const kpiText = kpi => {
        if (!kpi) return '対象外／未収録';
        const value = Number(kpi.value); let shown;
        if (kpi.unit === '%') shown = `${value.toLocaleString('ja-JP',{maximumFractionDigits:2})}%`;
        else if (kpi.unit === 'USD bn') shown = `${value.toLocaleString('ja-JP',{maximumFractionDigits:3})}十億ドル`;
        else if (kpi.unit === 'EUR bn') shown = `${value.toLocaleString('ja-JP',{maximumFractionDigits:3})}十億ユーロ`;
        else if (kpi.unit === 'JPY bn') shown = `${(value*10).toLocaleString('ja-JP',{maximumFractionDigits:1})}億円`;
        else if (kpi.unit === 'systems') shown = `${value.toLocaleString('ja-JP')}台`;
        else if (kpi.unit === 'connections') shown = `${value.toLocaleString('ja-JP')}件`;
        else if (kpi.unit === 'fibers') shown = `${value.toLocaleString('ja-JP')}心`;
        else shown = `${value.toLocaleString('ja-JP')} ${kpi.unit}`;
        return `${shown}\n${kpi.period}\n状態：検証済み`;
      };
      const scoreText = score => {
        if (!score) return '未評価';
        return `${score.value}/5\n方向：${({positive:'正',negative:'逆',mixed:'混合',neutral:'中立'})[score.direction] || score.direction}\n暫定分析`;
      };
      const metricRows = [
        { label:'売上高', key:null, getter:()=> '未収録' },
        { label:'FCF', key:null, getter:()=> '未収録' },
        { label:'設備投資額（Capex）', key:null, getter:()=> '未収録' },
        { label:'PER（実績）', key:'peTTM', getter:c=>metricText(c.metrics.peTTM) },
        { label:'PER（予想1期先）', key:'peFY1', getter:c=>metricText(c.metrics.peFY1) },
        { label:'PBR', key:'pb', getter:c=>metricText(c.metrics.pb) },
        { label:'ROIC', key:'roic', getter:c=>metricText(c.metrics.roic) },
        { label:'営業利益率', key:'operatingMargin', getter:c=>metricText(c.metrics.operatingMargin) },
        { label:'売上高成長率（前年同期比）', key:'revenueGrowth', getter:c=>metricText(c.metrics.revenueGrowth) },
      ];
      const addRow = (label,getter,picked,className='',note='') => {
        const tr=document.createElement('tr'); if(className) tr.className=className;
        const th=document.createElement('th'); th.textContent=note?`${label}\n${note}`:label; th.style.whiteSpace='pre-line'; tr.append(th);
        picked.forEach(c=>{const td=document.createElement('td');td.style.whiteSpace='pre-line';td.textContent=getter(c);tr.append(td);}); tbody.append(tr);
      };
      const sectionRow = (label,picked) => addRow(label,()=> '—',picked,'compare-section-row');
      const updateUrl = picked => { const next = new URLSearchParams(); if(picked.length) next.set('ids',picked.map(c=>c.id).join(',')); history.replaceState(null,'',`${location.pathname}${next.toString()?`?${next}`:''}`); };
      const comparisonNote = (key,picked) => {
        if (!key) return '現在は未収録';
        const definition = commonDefinitions[key]?.definition || '';
        const populated = picked.map(c=>c.metrics[key]).filter(m=>m && m.value != null);
        if (populated.length < 2) return definition;
        const periods = new Set(populated.map(m=>m.period).filter(Boolean));
        const bases = new Set(populated.map(m=>m.basis).filter(Boolean));
        const cautions = [];
        if (periods.size > 1) cautions.push('決算期間が異なる');
        if (bases.size > 1) cautions.push('算出基準が異なる');
        return [definition, cautions.length ? `比較注意：${cautions.join('・')}` : '比較条件：期間・定義一致'].filter(Boolean).join('\n');
      };
      const render = () => {
        const picked=selects.map(s=>byId.get(s.value)).filter(Boolean); if(!tbody||!theadRow)return;
        tbody.replaceChildren(); theadRow.replaceChildren();
        const lead=document.createElement('th');lead.textContent='指標';theadRow.append(lead);
        picked.forEach(c=>{const th=document.createElement('th');th.textContent=`${c.japaneseName||c.name}\n${c.ticker}`;th.style.whiteSpace='pre-line';theadRow.append(th);});
        sectionRow('事業・技術',picked);
        addRow('主領域',c=>c.primaryLayer,picked); addRow('国・地域',c=>c.country,picked);
        addRow('主力製品',c=>(c.products||[]).slice(0,4).join('\n')||'未収録',picked);
        addRow('主要技術',c=>(c.technologies||[]).slice(0,5).join(' / ')||'未収録',picked);
        addRow('主要拠点',c=>(c.facilities||[]).slice(0,4).join('\n')||'未収録',picked);
        sectionRow('共通財務',picked);
        metricRows.forEach(row=>addRow(row.label,row.getter,picked,'',comparisonNote(row.key,picked)));
        const definitionIds=[...new Set(picked.flatMap(c=>(c.kpis||[]).map(kpi=>kpi.definitionId)))];
        if(definitionIds.length){sectionRow('業種固有KPI',picked);definitionIds.forEach(id=>addRow(definitions[id]?.name||id,c=>kpiText((c.kpis||[]).find(item=>item.definitionId===id)),picked,'',definitions[id]?.description||''));}
        sectionRow('編集上の評価（分析）',picked);
        addRow('AI需要感応度',c=>scoreText(c.scores?.aiExposure),picked);
        addRow('金利感応度',c=>scoreText(c.scores?.rateSensitivity),picked);
        addRow('景気循環性',c=>scoreText(c.scores?.cyclicality),picked);
        updateUrl(picked);
      };
      selects.forEach(s=>s.addEventListener('change',render)); render();
    }
  </script>
</BaseLayout>
