---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { layerLabel, countryLabel } from '../lib/display';
const companies = (await getCollection('companies')).sort((a,b) => a.data.name.localeCompare(b.data.name));
const compact = companies.map(c => ({
  id:c.id, name:c.data.name, japaneseName:c.data.japaneseName, ticker:c.data.ticker,
  country:countryLabel(c.data.country), primaryLayer:layerLabel(c.data.primaryLayer),
  scores:{
    aiExposure:{ value:c.data.scores.aiExposure.value, direction:c.data.scores.aiExposure.direction },
    rateSensitivity:{ value:c.data.scores.rateSensitivity.value, direction:c.data.scores.rateSensitivity.direction },
    cyclicality:{ value:c.data.scores.cyclicality.value, direction:c.data.scores.cyclicality.direction },
    moat:{ value:c.data.scores.moat.value, direction:c.data.scores.moat.direction },
  },
  metrics:c.data.metrics
}));
const defaults = ['nvidia','tsmc','asml','vertiv'];
---
<BaseLayout title="企業比較">
  <header class="page-head">
    <div class="shell">
      <div class="eyebrow">企業横断比較</div>
      <h1>企業比較</h1>
      <p class="lead">最大4社を同時比較します。異業種でも共通指標は同じ行で比較し、業種固有KPIは別枠で扱います。</p>
    </div>
  </header>
  <div class="shell section" id="compare-app">
    <div class="notice">EquinixのようなREITと一般事業会社をPERだけで単純比較しない設計です。FFO/AFFOなど、業種ごとに意味のある指標を別途追加します。</div>
    <div class="compare-picks">
      {[0,1,2,3].map((slot) => (
        <label>比較企業 {slot+1}
          <select class="control compare-select" data-slot={slot}>
            <option value="">— 未選択 —</option>
            {companies.map(c => <option value={c.id} selected={c.id === defaults[slot]}>{c.data.japaneseName || c.data.name} ({c.data.ticker})</option>)}
          </select>
        </label>
      ))}
    </div>
    <div class="table-scroll">
      <table class="compare-table" id="compare-table"><tbody></tbody></table>
    </div>
    <script id="compare-data" type="application/json" set:html={JSON.stringify(compact)}></script>
  </div>
  <script is:inline>
    const root = document.querySelector('#compare-app');
    const dataNode = document.querySelector('#compare-data');
    if (root && dataNode) {
      const companies = JSON.parse(dataNode.textContent || '[]');
      const byId = new Map(companies.map(c => [c.id, c]));
      const selects = [...root.querySelectorAll('.compare-select')];
      const tbody = root.querySelector('#compare-table tbody');
      const directionLabels = { positive:'正方向', negative:'逆方向', mixed:'混合', neutral:'中立' };
      const scoreText = score => `${score.value}/5 · ${directionLabels[score.direction] || score.direction}`;
      const metricText = (metric, suffix='') => {
        if (!metric || metric.value == null) return 'N/A';
        const date = metric.asOf ? ` · ${metric.asOf}` : '';
        return `${metric.value}${suffix}${date}`;
      };
      const rows = [
        ['企業', c => `${c.japaneseName || c.name} (${c.ticker})`],
        ['主レイヤー', c => c.primaryLayer],
        ['国・地域', c => c.country],
        ['AI感応度', c => scoreText(c.scores.aiExposure)],
        ['金利感応度', c => scoreText(c.scores.rateSensitivity)],
        ['景気循環性', c => scoreText(c.scores.cyclicality)],
        ['競争優位', c => scoreText(c.scores.moat)],
        ['PER TTM', c => metricText(c.metrics.peTTM, '倍')],
        ['PER FY1', c => metricText(c.metrics.peFY1, '倍')],
        ['PBR', c => metricText(c.metrics.pb, '倍')],
        ['ROIC', c => metricText(c.metrics.roic, '%')],
        ['営業利益率', c => metricText(c.metrics.operatingMargin, '%')],
        ['売上高成長率（前年同期比）', c => metricText(c.metrics.revenueGrowth, '%')],
      ];
      const render = () => {
        const picked = selects.map(s => byId.get(s.value)).filter(Boolean);
        if (!tbody) return;
        tbody.replaceChildren();
        rows.forEach(([label, getter]) => {
          const tr = document.createElement('tr');
          const th = document.createElement('th'); th.textContent = label; tr.append(th);
          picked.forEach(c => { const td = document.createElement('td'); td.textContent = getter(c); tr.append(td); });
          tbody.append(tr);
        });
      };
      selects.forEach(s => s.addEventListener('change', render));
      render();
    }
  </script>
</BaseLayout>
