---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { layerLabel, countryLabel } from '../lib/display';
import sectorKpis from '../data/sector-kpis.json';
import sectorKpiDefinitions from '../data/sector-kpi-definitions.json';

const companies = (await getCollection('companies')).sort((a,b) => a.data.name.localeCompare(b.data.name));
const kpisByCompany = new Map();
for (const kpi of sectorKpis) {
  const list = kpisByCompany.get(kpi.companyId) ?? [];
  list.push(kpi);
  kpisByCompany.set(kpi.companyId, list);
}
const compact = companies.map(c => ({
  id:c.id, name:c.data.name, japaneseName:c.data.japaneseName, ticker:c.data.ticker,
  country:countryLabel(c.data.country), primaryLayer:layerLabel(c.data.primaryLayer),
  metrics:c.data.metrics,
  kpis:kpisByCompany.get(c.id) ?? []
}));
const definitions = Object.fromEntries(sectorKpiDefinitions.map(d => [d.id, d]));
const defaults = ['nvidia','tsmc','asml','tokyo-electron'];
---
<BaseLayout title="企業比較">
  <header class="page-head">
    <div class="shell">
      <span class="eyebrow">COMPARISON</span>
      <h1>企業比較</h1>
      <p class="lead">最大4社を同時比較します。主観的な点数は使わず、確認できた財務数値と業種固有KPIを同じ列位置で並べます。</p>
    </div>
  </header>
  <div class="shell section" id="compare-app">
    <p class="meta">異業種間ではPERや利益率だけで単純な優劣を付けません。業種固有KPIは、各社がAI設備投資のどこから売上を得ているかを確認する補助指標です。</p>
    <div class="compare-picks">
      {[0,1,2,3].map((slot) => (
        <label>比較企業 {slot+1}
          <select class="control compare-select" data-slot={slot}>
            <option value="">— 未選択 —</option>
            {companies.map(c => <option value={c.id} selected={c.id === defaults[slot]}>{c.data.japaneseName || c.data.name} ({c.data.ticker})</option>)}
          </select>
        </label>
      ))}
    </div>
    <div class="table-scroll">
      <table class="compare-table" id="compare-table">
        <thead><tr id="compare-head"><th>指標</th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <script id="compare-data" type="application/json" set:html={JSON.stringify({ companies: compact, definitions })}></script>
  </div>
  <script is:inline>
    const root = document.querySelector('#compare-app');
    const dataNode = document.querySelector('#compare-data');
    if (root && dataNode) {
      const payload = JSON.parse(dataNode.textContent || '{}');
      const companies = payload.companies || [];
      const definitions = payload.definitions || {};
      const byId = new Map(companies.map(c => [c.id, c]));
      const selects = [...root.querySelectorAll('.compare-select')];
      const tbody = root.querySelector('#compare-table tbody');
      const theadRow = root.querySelector('#compare-head');
      const metricText = (metric, suffix='') => {
        if (!metric || metric.value == null) return 'N/A';
        const date = metric.asOf ? `\n基準日 ${metric.asOf}` : '';
        return `${metric.value}${suffix}${date}`;
      };
      const kpiText = kpi => {
        if (!kpi) return 'N/A';
        const value = Number(kpi.value);
        let shown;
        if (kpi.unit === '%') shown = `${value.toLocaleString('ja-JP', { maximumFractionDigits:2 })}%`;
        else if (kpi.unit === 'USD bn') shown = `${value.toLocaleString('ja-JP', { maximumFractionDigits:3 })}十億ドル`;
        else if (kpi.unit === 'EUR bn') shown = `${value.toLocaleString('ja-JP', { maximumFractionDigits:3 })}十億ユーロ`;
        else if (kpi.unit === 'JPY bn') shown = `${(value * 10).toLocaleString('ja-JP', { maximumFractionDigits:1 })}億円`;
        else if (kpi.unit === 'systems') shown = `${value.toLocaleString('ja-JP')}台`;
        else if (kpi.unit === 'connections') shown = `${value.toLocaleString('ja-JP')}件`;
        else if (kpi.unit === 'fibers') shown = `${value.toLocaleString('ja-JP')}心`;
        else shown = `${value.toLocaleString('ja-JP')} ${kpi.unit}`;
        return `${shown}\n基準日 ${kpi.asOf}`;
      };
      const baseRows = [
        ['主領域', c => c.primaryLayer],
        ['国・地域', c => c.country],
        ['PER（実績）', c => metricText(c.metrics.peTTM, '倍')],
        ['PER（予想1期先）', c => metricText(c.metrics.peFY1, '倍')],
        ['PBR', c => metricText(c.metrics.pb, '倍')],
        ['ROIC', c => metricText(c.metrics.roic, '%')],
        ['営業利益率', c => metricText(c.metrics.operatingMargin, '%')],
        ['売上高成長率（前年同期比）', c => metricText(c.metrics.revenueGrowth, '%')],
      ];
      const addRow = (label, getter, picked, className='') => {
        const tr = document.createElement('tr');
        if (className) tr.className = className;
        const th = document.createElement('th');
        th.textContent = label;
        tr.append(th);
        picked.forEach(c => {
          const td = document.createElement('td');
          td.style.whiteSpace = 'pre-line';
          td.textContent = getter(c);
          tr.append(td);
        });
        tbody.append(tr);
      };
      const render = () => {
        const picked = selects.map(s => byId.get(s.value)).filter(Boolean);
        if (!tbody || !theadRow) return;
        tbody.replaceChildren();
        theadRow.replaceChildren();
        const lead = document.createElement('th'); lead.textContent = '指標'; theadRow.append(lead);
        picked.forEach(c => {
          const th = document.createElement('th');
          th.textContent = `${c.japaneseName || c.name}\n${c.ticker}`;
          th.style.whiteSpace = 'pre-line';
          theadRow.append(th);
        });
        baseRows.forEach(([label, getter]) => addRow(label, getter, picked));

        const definitionIds = [...new Set(picked.flatMap(c => (c.kpis || []).map(kpi => kpi.definitionId)))];
        if (definitionIds.length) {
          addRow('業種固有KPI', () => '—', picked, 'compare-section-row');
          definitionIds.forEach(definitionId => {
            const definition = definitions[definitionId];
            addRow(definition?.name || definitionId, c => {
              const kpi = (c.kpis || []).find(item => item.definitionId === definitionId);
              return kpiText(kpi);
            }, picked);
          });
        }
      };
      selects.forEach(s => s.addEventListener('change', render));
      render();
    }
  </script>
</BaseLayout>
