---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/paths';
import valueChain from '../data/value-chain.json';
import updateLog from '../data/update-log.json';
import metricAudits from '../data/metric-audits.json';
import sectorKpis from '../data/sector-kpis.json';
import roicCalculations from '../data/roic-calculations.json';

const companies = await getCollection('companies');
const companyById = new Map(companies.map(company => [company.id, company]));
const verifiedCompanyIds = new Set([
  ...metricAudits.filter(audit => audit.verificationStatus === 'verified').map(audit => audit.companyId),
  ...sectorKpis.filter(kpi => kpi.status === 'verified').map(kpi => kpi.companyId),
  ...roicCalculations.filter(calc => calc.status === 'verified').map(calc => calc.companyId),
]);
const countryCount = new Set(companies.map(company => company.data.country)).size;
const processCount = valueChain.filter(stage => stage.id !== 'demand').length;
const lastDbUpdate = updateLog[0]?.date ?? '—';
const linkHref = (link: any) => link.technology
  ? `${withBase('companies/')}?technology=${encodeURIComponent(link.technology)}`
  : link.tag
    ? `${withBase('companies/')}?tag=${encodeURIComponent(link.tag)}`
    : `${withBase('companies/')}?q=${encodeURIComponent(link.query)}`;
---
<BaseLayout>
  <div class="shell">
    <section class="home-intro">
      <span class="eyebrow">産業調査データベース</span>
      <h1>AI Infrastructure Atlas</h1>
      <p class="home-intro-copy">AI・半導体産業を、工程・企業・工場・決算から辿る。</p>
      <form class="search-box" action={withBase('companies/')} method="get">
        <input class="control" type="search" name="q" placeholder="企業・製品・工程・主要拠点を検索" aria-label="企業・製品・工程・主要拠点を検索" />
        <button class="primary-button" type="submit">検索</button>
      </form>
      <dl class="db-status" aria-label="データベース収録状況">
        <div><dt>収録企業</dt><dd>{companies.length}社</dd></div>
        <div><dt>検証済み数値あり</dt><dd>{verifiedCompanyIds.size}社</dd></div>
        <div><dt>対応国・地域</dt><dd>{countryCount}</dd></div>
        <div><dt>工程区分</dt><dd>{processCount}</dd></div>
        <div><dt>最終DB更新</dt><dd class="mono">{lastDbUpdate}</dd></div>
      </dl>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><span class="eyebrow">バリューチェーン</span><h2>AIインフラの主要工程</h2></div>
        <p>技術名から企業を直接絞り込めます。詳細な工程関係は<a href={withBase('atlas/')}>全体マップ</a>で確認できます。</p>
      </div>
      <div class="home-value-chain" aria-label="AIインフラ主要工程">
        {valueChain.filter(stage => stage.id !== 'demand').map(stage => (
          <div class={`home-stage vc-${stage.id}`}>
            <a class="home-stage-title" href={`${withBase('companies/')}?stage=${encodeURIComponent(stage.id)}`}><span class="value-stage-code">{stage.number}</span>{stage.name}</a>
            <div class="home-stage-links">{stage.links.slice(0,4).map(link => <a href={linkHref(link)}>{link.label}</a>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><span class="eyebrow">更新履歴</span><h2>最近の更新</h2></div>
        <p>企業の数を並べるのではなく、現在このDBで何が検証・更新されているかを記録します。</p>
      </div>
      <div class="table-scroll">
        <table class="data-table update-table">
          <thead><tr><th>日付</th><th>対象</th><th>更新内容</th><th>詳細</th></tr></thead>
          <tbody>
            {updateLog.map(entry => {
              const company = entry.companyId ? companyById.get(entry.companyId) : null;
              return <tr><td class="mono">{entry.date}</td><td>{company ? <a href={withBase(`companies/${company.id}/`)}>{company.data.japaneseName || company.data.name}</a> : 'データベース'}</td><td>{entry.title}</td><td>{entry.detail}</td></tr>;
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>
</BaseLayout>
