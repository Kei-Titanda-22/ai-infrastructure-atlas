---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyCard from '../components/CompanyCard.astro';
import { getCollection } from 'astro:content';
import layers from '../data/layers.json';
import { withBase } from '../lib/paths';

const companies = await getCollection('companies');
const featuredIds = ['nvidia','tsmc','sk-hynix','asml','tokyo-electron','arista','vertiv','fanuc'];
const featured = featuredIds.map(id => companies.find(c => c.id === id)).filter(Boolean);
---
<BaseLayout>
  <div class="shell">
    <section class="hero">
      <div>
        <div class="eyebrow">半導体 → データセンター → Physical AI</div>
        <h1>AI Infrastructure<br />Atlas</h1>
        <p>半導体、製造装置、メモリ、ネットワーク、光通信、データセンター、電力・冷却、Physical AIを一つのバリューチェーンとして追跡する個人用リサーチ基盤。</p>
        <form class="search-box" action={withBase('companies/')} method="get">
          <input class="control" type="search" name="q" placeholder="企業名・ティッカー・製品で検索" aria-label="企業を検索" />
          <button class="primary-button" type="submit">企業を検索</button>
        </form>
      </div>
      <div class="hero-stats" aria-label="Atlasの収録状況">
        <div class="hero-stat"><span class="stat-value">20</span><span class="stat-label">中核企業</span></div>
        <div class="hero-stat"><span class="stat-value">8</span><span class="stat-label">バリューチェーン層</span></div>
        <div class="hero-stat"><span class="stat-value">4</span><span class="stat-label">同時比較企業数</span></div>
        <div class="hero-stat"><span class="stat-value">v0.2</span><span class="stat-label">一次情報データ整備中</span></div>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><span class="eyebrow">バリューチェーン</span><h2>AI投資がどこへ伝播するか</h2></div>
        <p>単純な業種分類よりも「AI設備投資の伝播経路」を優先。企業は複数レイヤーに所属可能とし、主分類だけを一覧整理に使用します。</p>
      </div>
      <div class="chain">
        {layers.map((layer, index) => (
          <a class="chain-card" href={`${withBase('companies/')}?layer=${encodeURIComponent(layer.name)}`}>
            <span class="chain-index">0{index + 1}</span>
            <h3>{layer.name}</h3>
            <p>{layer.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><span class="eyebrow">中核20社</span><h2>横断比較の起点</h2></div>
        <p>20社を起点に、一次資料を文書単位で登録し、決算・財務・業種固有KPIを検証済みデータから順次追加します。</p>
      </div>
      <div class="grid company-grid">
        {featured.map(company => <CompanyCard company={company} />)}
      </div>
    </section>

    <section class="section">
      <div class="notice">AI感応度・金利感応度などのスコアは分析・判断データであり、決算数値などの客観データとは分離しています。PER/PBR/ROIC等は、出典・基準日・定義を確認できたものだけを掲載します。</div>
    </section>
  </div>
</BaseLayout>
