---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompanyCard from '../components/CompanyCard.astro';
import { getCollection } from 'astro:content';
import layers from '../data/layers.json';
import { withBase } from '../lib/paths';
import { layerLabel } from '../lib/display';

const companies = await getCollection('companies');
const featuredIds = ['nvidia','tsmc','sk-hynix','asml','tokyo-electron','arista','vertiv','fanuc'];
const featured = featuredIds.map(id => companies.find(c => c.id === id)).filter(Boolean);
---
<BaseLayout>
  <div class="shell">
    <section class="hero">
      <div>
        <div class="eyebrow">半導体・AIインフラ企業データベース</div>
        <h1>AI Infrastructure Atlas</h1>
        <p>半導体、製造装置、メモリ、ネットワーク、光通信、データセンター、電力・冷却、Physical AIまで、AI設備投資の流れに沿って企業を調査・比較するための個人用リサーチ基盤です。</p>
        <form class="search-box" action={withBase('companies/')} method="get">
          <input class="control" type="search" name="q" placeholder="企業名・ティッカー・製品・拠点都市で検索" aria-label="企業を検索" />
          <button class="primary-button" type="submit">検索</button>
        </form>
      </div>
      <dl class="hero-facts" aria-label="Atlasの収録状況">
        <div><dt>収録企業</dt><dd>20社</dd></div>
        <div><dt>産業領域</dt><dd>8領域</dd></div>
        <div><dt>同時比較</dt><dd>最大4社</dd></div>
        <div><dt>データ方針</dt><dd>一次情報優先</dd></div>
      </dl>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><span class="eyebrow">バリューチェーン</span><h2>AI投資がどこへ伝播するか</h2></div>
        <p>単純な業種分類ではなく、AI設備投資の伝播経路を優先します。企業は複数領域に所属でき、各企業の製品・顧客・設備投資とのつながりを順次追加します。</p>
      </div>
      <div class="chain">
        {layers.map((layer, index) => (
          <a class="chain-card" href={`${withBase('companies/')}?layer=${encodeURIComponent(layer.name)}`}>
            <span class="chain-index">0{index + 1}</span>
            <h3>{layerLabel(layer.name)}</h3>
            <p>{layer.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><span class="eyebrow">中核20社</span><h2>横断比較の起点</h2></div>
        <p>企業ごとに一次資料を文書単位で登録し、決算・財務指標・業種固有KPI・主要製造拠点を検証済みデータから追加しています。</p>
      </div>
      <div class="grid company-grid">
        {featured.map(company => <CompanyCard company={company} />)}
      </div>
    </section>

    <section class="section">
      <div class="notice">AI感応度・金利感応度などの評価は分析データとして、決算数値・拠点情報などの客観データとは分離して管理します。PER/PBR/ROIC等も、出典・基準日・定義を確認できたものだけを掲載します。</div>
    </section>
  </div>
</BaseLayout>
