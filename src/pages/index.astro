---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/paths';
import valueChain from '../data/value-chain.json';
import updateLog from '../data/update-log.json';
import metricAudits from '../data/metric-audits.json';
import sectorKpis from '../data/sector-kpis.json';
import roicCalculations from '../data/roic-calculations.json';
import { buildSearchText } from '../lib/search-normalization';

const companies = await getCollection('companies');
const companyById = new Map(companies.map(company => [company.id, company]));
const verifiedCompanyIds = new Set([
  ...metricAudits.filter(audit => audit.verificationStatus === 'verified').map(audit => audit.companyId),
  ...sectorKpis.filter(kpi => kpi.status === 'verified').map(kpi => kpi.companyId),
  ...roicCalculations.filter(calc => calc.status === 'verified').map(calc => calc.companyId),
]);
const countryCount = new Set(companies.map(company => company.data.country)).size;
const processCount = valueChain.filter(stage => stage.id !== 'demand').length;
const lastDbUpdate = updateLog[0]?.date ?? '—';
const homeCompanySearchCandidates = companies.map(company => ({
  id: company.id,
  label: company.data.japaneseName || company.data.name,
  meta: `${company.data.ticker || '非上場'} · ${company.data.country}`,
  href: withBase(`companies/${company.id}/`),
  searchText: buildSearchText([company.id, company.data.name, company.data.japaneseName, company.data.reading, company.data.ticker]),
}));
const stageDescriptors: Record<string, string> = {
  compute: 'AIの計算を担うチップ',
  memory: '計算中・保存用のデータを保持',
  materials: 'チップを作る素材と実装基板',
  manufacturing: '設計されたチップを製造',
  backend: '検査・パッケージング',
  interconnect: 'サーバーやラック間を高速接続',
  datacenter: '電源・冷却・受配電',
  physical: '現実世界で動くAI',
};
const linkHref = (link: any) => link.technology
  ? `${withBase('companies/')}?technology=${encodeURIComponent(link.technology)}`
  : link.tag
    ? `${withBase('companies/')}?tag=${encodeURIComponent(link.tag)}`
    : `${withBase('companies/')}?q=${encodeURIComponent(link.query)}`;
---
<BaseLayout pageClass="global-visual-pilot global-visual-home">
  <div class="shell">
    <section class="home-intro">
      <span class="eyebrow">産業調査データベース</span>
      <h1>AI Infrastructure Atlas</h1>
      <p class="home-intro-copy">AI・半導体産業を、工程・企業・工場・決算から辿る。</p>
      <div class="home-search-control">
        <form class="search-box" id="home-company-search-form" action={withBase('companies/')} method="get" data-company-search={JSON.stringify(homeCompanySearchCandidates)}>
          <input class="control" id="home-company-search" type="search" name="q" placeholder="企業・製品・工程・主要拠点を検索" aria-label="企業・製品・工程・主要拠点を検索" autocomplete="off" aria-controls="home-company-suggestions" aria-expanded="false" />
          <button class="primary-button" type="submit">検索</button>
        </form>
        <div class="home-search-suggestions" id="home-company-suggestions" role="listbox" hidden></div>
        <p class="search-combobox-status" id="home-company-suggestions-status" aria-live="polite"></p>
      </div>
      <dl class="db-status" aria-label="データベース収録状況">
        <div><dt>収録企業</dt><dd>{companies.length}社</dd></div>
        <div><dt>検証済み数値あり</dt><dd>{verifiedCompanyIds.size}社</dd></div>
        <div><dt>対応国・地域</dt><dd>{countryCount}</dd></div>
        <div><dt>工程区分</dt><dd>{processCount}</dd></div>
        <div><dt>最終DB更新</dt><dd class="mono">{lastDbUpdate}</dd></div>
      </dl>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><span class="eyebrow">バリューチェーン</span><h2>AIインフラの主要工程</h2></div>
        <p>技術名から企業を直接絞り込めます。詳細な工程関係は<a href={withBase('atlas/')}>全体マップ</a>で確認できます。</p>
      </div>
      <div class="home-value-chain" aria-label="AIインフラ主要工程">
        {valueChain.filter(stage => stage.id !== 'demand').map(stage => (
          <div class={`home-stage vc-${stage.id}`}>
            <a class="home-stage-title" href={`${withBase('companies/')}?stage=${encodeURIComponent(stage.id)}`}><span class="value-stage-code">{stage.number}</span>{stage.name}</a>
            <p class="home-stage-description">{stageDescriptors[stage.id]}</p>
            <div class="home-stage-links">{stage.links.slice(0,4).map(link => <a href={linkHref(link)}>{link.label}</a>)}</div>
          </div>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div><span class="eyebrow">更新履歴</span><h2>最近の更新</h2></div>
        <p>企業の数を並べるのではなく、現在このDBで何が検証・更新されているかを記録します。</p>
      </div>
      <div class="table-scroll">
        <table class="data-table update-table">
          <thead><tr><th>日付</th><th>対象</th><th>更新内容</th><th>詳細</th></tr></thead>
          <tbody>
            {updateLog.map(entry => {
              const company = entry.companyId ? companyById.get(entry.companyId) : null;
              return <tr><td class="mono">{entry.date}</td><td>{company ? <a href={withBase(`companies/${company.id}/`)}>{company.data.japaneseName || company.data.name}</a> : 'データベース'}</td><td>{entry.title}</td><td>{entry.detail}</td></tr>;
            })}
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <script>
    import { searchTokens } from '../lib/search-normalization';
    import { createSearchComboboxController } from '../scripts/search-combobox-controller';

    const form = document.querySelector('#home-company-search-form');
    const input = document.querySelector('#home-company-search');
    const listbox = document.querySelector('#home-company-suggestions');
    const status = document.querySelector('#home-company-suggestions-status');
    if (form instanceof HTMLFormElement && input instanceof HTMLInputElement && listbox instanceof HTMLElement && status instanceof HTMLElement) {
      const candidates = JSON.parse(form.dataset.companySearch || '[]');
      const combobox = createSearchComboboxController({
        input,
        listbox,
        status,
        optionIdPrefix: 'home-company-suggestion',
        getMatches: query => {
          const tokens = searchTokens(query);
          if (!tokens.length) return [];
          return candidates.filter((company: any) => tokens.every(token => company.searchText.includes(token))).slice(0, 10);
        },
        renderOption: company => {
          const button = document.createElement('button');
          button.type = 'button';
          button.className = 'home-search-suggestion';
          button.dataset.searchOptionId = company.id;
          const name = document.createElement('span');
          name.className = 'home-search-suggestion-name';
          name.textContent = company.label;
          const meta = document.createElement('span');
          meta.className = 'home-search-suggestion-meta';
          meta.textContent = company.meta;
          button.append(name, meta);
          return button;
        },
        select: company => { location.assign(company.href); },
      });
      document.addEventListener('click', event => {
        if (!(event.target instanceof Node) || form.parentElement?.contains(event.target)) return;
        combobox.close();
      });
    }
  </script>
</BaseLayout>
