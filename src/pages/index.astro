---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../lib/paths';
import { layerLabel, countryLabel, tagLabel } from '../lib/display';

const companies = await getCollection('companies');
const featuredIds = ['nvidia','tsmc','sk-hynix','asml','tokyo-electron','arista','vertiv','fanuc'];
const featured = featuredIds.map(id => companies.find(c => c.id === id)).filter(Boolean);

const valueStages = [
  { code:'01 COMPUTE', title:'計算半導体', tags:['GPU','ASIC','AI accelerator'] },
  { code:'02 MEMORY', title:'メモリ', tags:['HBM','DRAM','NAND','SSD'] },
  { code:'03 MANUFACTURING', title:'半導体製造', tags:['lithography','deposition','etch','cleaning','inspection','ATE'] },
  { code:'04 INTERCONNECT', title:'接続・光通信', tags:['Ethernet','optical fiber','data center cable','interconnection'] },
  { code:'05 DATA CENTER', title:'電力・冷却・施設', tags:['power distribution','UPS','cooling','colocation'] },
  { code:'06 PHYSICAL AI', title:'フィジカルAI', tags:['industrial robot','CNC','factory automation'] },
];
---
<BaseLayout>
  <div class="shell">
    <section class="home-intro">
      <span class="eyebrow">INDUSTRY RESEARCH DATABASE</span>
      <h1>AI Infrastructure Atlas</h1>
      <p class="home-intro-copy">AI・半導体産業を、工程・企業・工場・決算から辿る。</p>
      <form class="search-box" action={withBase('companies/')} method="get">
        <input class="control" type="search" name="q" placeholder="企業・製品・工程・主要拠点を検索" aria-label="企業・製品・工程・主要拠点を検索" />
        <button class="primary-button" type="submit">検索</button>
      </form>
      <div class="home-status" aria-label="収録状況">
        <span>収録企業 20社</span>
        <span>産業領域 8</span>
        <span>一次情報を優先</span>
        <span>リアルタイム株価なし</span>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">VALUE CHAIN</span>
          <h2>AIインフラの主要工程</h2>
        </div>
        <p>青字の技術名から、その属性を持つ企業へ直接絞り込めます。内部の8領域分類は維持しつつ、入口では6段の産業フローに整理しています。</p>
      </div>
      <div class="value-chain" aria-label="AIインフラのバリューチェーン">
        {valueStages.map(stage => (
          <section class="value-stage">
            <span class="value-stage-code">{stage.code}</span>
            <h3>{stage.title}</h3>
            <div class="value-stage-links">
              {stage.tags.map(tag => <a href={`${withBase('companies/')}?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>)}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">RESEARCH UNIVERSE</span>
          <h2>中核企業</h2>
        </div>
        <p>同種情報をカードではなく固定列で表示します。企業名、国・地域、主領域、主要技術、更新日を同じ位置で追えます。</p>
      </div>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr><th>企業</th><th>国・地域</th><th>主領域</th><th>主要技術</th><th>更新日</th></tr>
          </thead>
          <tbody>
            {featured.map(company => {
              const d = company.data;
              return (
                <tr>
                  <td><a class="company-link" href={withBase(`companies/${company.id}/`)}>{d.japaneseName || d.name}</a><span class="company-index-en">{d.ticker} · {d.name}</span></td>
                  <td>{countryLabel(d.country)}</td>
                  <td><a class="filter-link" href={`${withBase('companies/')}?layer=${encodeURIComponent(d.primaryLayer)}`}>{layerLabel(d.primaryLayer)}</a></td>
                  <td class="table-links">{d.tags.slice(0,3).map(tag => <a href={`${withBase('companies/')}?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>)}</td>
                  <td class="mono">{d.lastReviewed}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
      <p class="meta" style="margin-top:10px"><a href={withBase('companies/')}>全20社の企業一覧を見る</a></p>
    </section>
  </div>
</BaseLayout>
