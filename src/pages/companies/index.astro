---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import facilities from '../../data/facilities.json';
import valueChain from '../../data/value-chain.json';
import { layerLabel, countryLabel, tagLabel, productInfo } from '../../lib/display';
import { withBase } from '../../lib/paths';

const companies = (await getCollection('companies')).sort((a,b) => (a.data.japaneseName || a.data.name).localeCompare(b.data.japaneseName || b.data.name, 'ja'));
const layers = [...new Set(companies.map(c => c.data.primaryLayer))].sort();
const countries = [...new Set(companies.map(c => c.data.country))].sort();
const tags = [...new Set(companies.flatMap(c => c.data.tags))].sort((a,b) => tagLabel(a).localeCompare(tagLabel(b), 'ja'));
const facilitiesByCompany = new Map();
for (const facility of facilities) {
  const list = facilitiesByCompany.get(facility.companyId) ?? [];
  list.push(facility);
  facilitiesByCompany.set(facility.companyId, list);
}
const stageLabelById = new Map(valueChain.map(stage => [stage.id, stage.name]));
const stageIdsForLayers = (companyLayers: string[]) => {
  const ids = new Set<string>();
  if (companyLayers.includes('Compute & Silicon')) ids.add('compute');
  if (companyLayers.includes('Memory')) ids.add('memory');
  if (companyLayers.includes('Foundry & Logic Manufacturing') || companyLayers.includes('Wafer Fab Equipment')) ids.add('manufacturing');
  if (companyLayers.includes('Test & Back-end')) ids.add('backend');
  if (companyLayers.includes('Network & Optical')) ids.add('interconnect');
  if (companyLayers.includes('Data Center & Facilities')) ids.add('datacenter');
  if (companyLayers.includes('Physical AI')) ids.add('physical');
  return [...ids];
};
---
<BaseLayout title="企業一覧">
  <header class="page-head">
    <div class="shell">
      <span class="eyebrow">企業データベース</span>
      <h1>企業一覧</h1>
      <p class="lead">企業名、ティッカー、製品、技術、国・地域、主要拠点を横断検索できます。空白で区切るとAND検索になります。</p>
    </div>
  </header>

  <div class="shell section" id="companies-app">
    <div class="toolbar">
      <input id="company-search" class="control" type="search" placeholder="HBM Korea / AI 電力 / 三重県 ..." aria-label="企業検索" />
      <select id="layer-filter" class="control" aria-label="領域で絞り込み">
        <option value="">すべての領域</option>
        {layers.map(layer => <option value={layer}>{layerLabel(layer)}</option>)}
      </select>
      <select id="country-filter" class="control" aria-label="国・地域で絞り込み">
        <option value="">すべての国・地域</option>
        {countries.map(country => <option value={country}>{countryLabel(country)}</option>)}
      </select>
      <select id="tag-filter" class="control" aria-label="技術タグで絞り込み">
        <option value="">すべての技術タグ</option>
        {tags.map(tag => <option value={tag}>{tagLabel(tag)}</option>)}
      </select>
    </div>
    <div id="stage-filter-note" class="active-filter" hidden><span id="stage-filter-label"></span><button type="button" id="stage-filter-clear">工程指定を解除</button></div>
    <p class="result-count" id="result-count">{companies.length}社</p>

    <div class="table-scroll company-table-scroll">
      <table class="data-table company-index-table" id="company-table">
        <thead>
          <tr>
            <th class="company-col" data-sort-header="name" aria-sort="ascending"><button class="sort-button" type="button" data-sort="name">企業 <span class="sort-indicator">↑</span></button></th>
            <th data-sort-header="country"><button class="sort-button" type="button" data-sort="country">国・地域 <span class="sort-indicator">↕</span></button></th>
            <th data-sort-header="layer"><button class="sort-button" type="button" data-sort="layer">主領域 <span class="sort-indicator">↕</span></button></th>
            <th>主力製品</th><th>主要技術</th><th>主要拠点</th>
            <th data-sort-header="updated"><button class="sort-button" type="button" data-sort="updated">更新日 <span class="sort-indicator">↕</span></button></th>
          </tr>
        </thead>
        <tbody id="company-tbody">
          {companies.map(company => {
            const d = company.data;
            const sites = facilitiesByCompany.get(company.id) ?? [];
            const productLabels = d.products.map(product => productInfo(product).label);
            const stageIds = stageIdsForLayers(d.layers);
            const searchText = [
              d.name, d.japaneseName, d.reading, d.ticker, d.country, countryLabel(d.country),
              d.primaryLayer, layerLabel(d.primaryLayer), d.summary, d.aiRole,
              ...d.tags, ...d.tags.map(tagLabel), ...d.products, ...productLabels,
              ...stageIds.map(id => stageLabelById.get(id) || id), ...sites.flatMap(site => [site.city, site.region, site.country])
            ].join(' ').toLowerCase();
            return (
              <tr data-company-row data-search={searchText} data-tags={d.tags.join('|')} data-layer={d.primaryLayer} data-country={d.country} data-stages={stageIds.join('|')} data-sort-name={d.japaneseName || d.name} data-sort-country={countryLabel(d.country)} data-sort-layer={layerLabel(d.primaryLayer)} data-sort-updated={d.lastReviewed}>
                <td class="company-col"><span class="company-index-name"><a href={withBase(`companies/${company.id}/`)}>{d.japaneseName || d.name}</a></span><span class="company-index-en"><span class="mono">{d.ticker}</span> · {d.name}</span></td>
                <td><a class="filter-link" href={`${withBase('companies/')}?country=${encodeURIComponent(d.country)}`}>{countryLabel(d.country)}</a></td>
                <td><a class="filter-link" href={`${withBase('companies/')}?layer=${encodeURIComponent(d.primaryLayer)}`}>{layerLabel(d.primaryLayer)}</a></td>
                <td class="company-index-products">{productLabels.slice(0,2).join(' / ')}{productLabels.length > 2 ? <span class="table-more"> +{productLabels.length - 2}</span> : null}</td>
                <td class="company-index-tags table-links">{d.tags.slice(0,3).map(tag => <a href={`${withBase('companies/')}?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>)}{d.tags.length > 3 ? <span class="table-more">+{d.tags.length - 3}</span> : null}</td>
                <td class="company-index-sites">{sites.length ? <>{sites[0].city}（<a class="filter-link" href={`${withBase('companies/')}?q=${encodeURIComponent(sites[0].region)}`}>{sites[0].region}</a>）{sites.length > 1 ? <span class="table-more"> +{sites.length - 1}</span> : null}</> : '—'}</td>
                <td class="mono">{d.lastReviewed}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </div>

  <script is:inline>
    const root = document.querySelector('#companies-app');
    if (root) {
      const input = root.querySelector('#company-search');
      const layer = root.querySelector('#layer-filter');
      const country = root.querySelector('#country-filter');
      const tag = root.querySelector('#tag-filter');
      const tbody = root.querySelector('#company-tbody');
      const rows = [...root.querySelectorAll('[data-company-row]')];
      const count = root.querySelector('#result-count');
      const sortButtons = [...root.querySelectorAll('[data-sort]')];
      const stageNote = root.querySelector('#stage-filter-note');
      const stageLabel = root.querySelector('#stage-filter-label');
      const stageClear = root.querySelector('#stage-filter-clear');
      const params = new URLSearchParams(location.search);
      const stageNames = { compute:'計算半導体', memory:'メモリ・ストレージ', manufacturing:'半導体製造', backend:'テスト・後工程', interconnect:'ネットワーク・光通信', datacenter:'データセンター設備', physical:'フィジカルAI' };
      let stage = params.get('stage') || '';
      let sortKey = params.get('sort') || 'name';
      let sortDirection = params.get('order') === 'desc' ? -1 : 1;

      if (input instanceof HTMLInputElement && params.get('q')) input.value = params.get('q') || '';
      if (layer instanceof HTMLSelectElement && params.get('layer')) layer.value = params.get('layer') || '';
      if (country instanceof HTMLSelectElement && params.get('country')) country.value = params.get('country') || '';
      if (tag instanceof HTMLSelectElement && params.get('tag')) tag.value = params.get('tag') || '';

      const updateStageNote = () => {
        if (!(stageNote instanceof HTMLElement)) return;
        stageNote.hidden = !stage;
        if (stageLabel) stageLabel.textContent = stage ? `工程：${stageNames[stage] || stage}` : '';
      };
      const updateUrl = () => {
        const next = new URLSearchParams();
        if (input instanceof HTMLInputElement && input.value.trim()) next.set('q', input.value.trim());
        if (layer instanceof HTMLSelectElement && layer.value) next.set('layer', layer.value);
        if (country instanceof HTMLSelectElement && country.value) next.set('country', country.value);
        if (tag instanceof HTMLSelectElement && tag.value) next.set('tag', tag.value);
        if (stage) next.set('stage', stage);
        if (sortKey !== 'name') next.set('sort', sortKey);
        if (sortDirection === -1) next.set('order', 'desc');
        const qs = next.toString();
        history.replaceState(null, '', `${location.pathname}${qs ? `?${qs}` : ''}`);
      };
      const sortRows = () => {
        if (!tbody) return;
        const key = `sort${sortKey.charAt(0).toUpperCase()}${sortKey.slice(1)}`;
        rows.sort((a, b) => (a.dataset[key] || '').localeCompare(b.dataset[key] || '', 'ja', { numeric: true }) * sortDirection);
        rows.forEach(row => tbody.append(row));
        root.querySelectorAll('[data-sort-header]').forEach(header => {
          const active = header.dataset.sortHeader === sortKey;
          header.setAttribute('aria-sort', active ? (sortDirection === 1 ? 'ascending' : 'descending') : 'none');
          const indicator = header.querySelector('.sort-indicator');
          if (indicator) indicator.textContent = active ? (sortDirection === 1 ? '↑' : '↓') : '↕';
        });
      };
      const apply = () => {
        const query = input instanceof HTMLInputElement ? input.value.trim().toLowerCase() : '';
        const tokens = query.split(/\s+/).filter(Boolean);
        const l = layer instanceof HTMLSelectElement ? layer.value : '';
        const c = country instanceof HTMLSelectElement ? country.value : '';
        const t = tag instanceof HTMLSelectElement ? tag.value : '';
        let visible = 0;
        rows.forEach(row => {
          const haystack = row.dataset.search || '';
          const rowTags = (row.dataset.tags || '').split('|').filter(Boolean);
          const rowStages = (row.dataset.stages || '').split('|').filter(Boolean);
          const hit = tokens.every(token => haystack.includes(token)) && (!l || row.dataset.layer === l) && (!c || row.dataset.country === c) && (!t || rowTags.includes(t)) && (!stage || rowStages.includes(stage));
          row.hidden = !hit;
          if (hit) visible++;
        });
        if (count) count.textContent = `${visible}社 / 全${rows.length}社`;
        updateStageNote();
        updateUrl();
      };
      sortButtons.forEach(button => button.addEventListener('click', () => { const nextKey = button.dataset.sort || 'name'; if (sortKey === nextKey) sortDirection *= -1; else { sortKey = nextKey; sortDirection = 1; } sortRows(); updateUrl(); }));
      stageClear?.addEventListener('click', () => { stage = ''; apply(); });
      input?.addEventListener('input', apply);
      layer?.addEventListener('change', apply);
      country?.addEventListener('change', apply);
      tag?.addEventListener('change', apply);
      sortRows(); apply();
    }
  </script>
</BaseLayout>
