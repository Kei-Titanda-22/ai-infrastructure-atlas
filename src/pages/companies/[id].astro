---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { layerLabel, countryLabel, tagLabel, facilityTypeLabel, productInfo } from '../../lib/display';
import sources from '../../data/sources.json';
import documentSources from '../../data/document-sources.json';
import facilitySources from '../../data/facility-sources.json';
import facilities from '../../data/facilities.json';
import brandAssets from '../../data/brand-assets.json';
import sectorKpis from '../../data/sector-kpis.json';
import sectorKpiDefinitions from '../../data/sector-kpi-definitions.json';
import roicCalculations from '../../data/roic-calculations.json';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map(company => ({ params: { id: company.id }, props: { company } }));
}

const { company } = Astro.props;
const d = company.data;
const allCompanies = await getCollection('companies');
const allSources = [...sources, ...documentSources, ...facilitySources];
const peers = d.competitors.map(id => allCompanies.find(c => c.id === id)).filter(Boolean);
const companyFacilities = facilities.filter(facility => facility.companyId === company.id);
const facilitySourceIds = new Set(companyFacilities.map(facility => facility.sourceId));
const companySources = allSources.filter(source => d.sourceIds.includes(source.id) || facilitySourceIds.has(source.id));
const brandAsset = brandAssets.find(asset => asset.companyId === company.id);
const companyKpis = sectorKpis.filter(kpi => kpi.companyId === company.id);
const companyRoic = roicCalculations.find(calc => calc.companyId === company.id && d.metrics.roic.calculationId === calc.id);
const kpiDefinitionById = new Map(sectorKpiDefinitions.map(definition => [definition.id, definition]));
const metricLabels: Record<string, string> = {
  peTTM:'PER（実績）', peFY1:'PER（予想1期先）', pb:'PBR', roic:'ROIC',
  operatingMargin:'営業利益率', revenueGrowth:'売上高成長率（前年同期比）'
};
const statusLabels: Record<string, string> = { verified:'検証済み', partial:'一部検証済み', placeholder:'未検証' };
const sourceById = new Map(allSources.map(source => [source.id, source]));

const formatMetric = (metric: any) => {
  if (metric.value === null) return 'N/A';
  if (metric.unit === 'x') return `${Number(metric.value).toLocaleString('ja-JP', { maximumFractionDigits: 2 })}倍`;
  if (metric.unit === '%') return `${Number(metric.value).toLocaleString('ja-JP', { maximumFractionDigits: 2 })}%`;
  return `${Number(metric.value).toLocaleString('ja-JP')} ${metric.unit}`;
};
const formatKpi = (kpi: any) => {
  const value = Number(kpi.value);
  if (kpi.unit === '%') return `${value.toLocaleString('ja-JP', { maximumFractionDigits: 2 })}%`;
  if (kpi.unit === 'USD bn') return `${value.toLocaleString('ja-JP', { maximumFractionDigits: 3 })}十億ドル`;
  if (kpi.unit === 'EUR bn') return `${value.toLocaleString('ja-JP', { maximumFractionDigits: 3 })}十億ユーロ`;
  if (kpi.unit === 'JPY bn') return `${(value * 10).toLocaleString('ja-JP', { maximumFractionDigits: 1 })}億円`;
  if (kpi.unit === 'systems') return `${value.toLocaleString('ja-JP')}台`;
  if (kpi.unit === 'connections') return `${value.toLocaleString('ja-JP')}件`;
  if (kpi.unit === 'fibers') return `${value.toLocaleString('ja-JP')}心`;
  return `${value.toLocaleString('ja-JP')} ${kpi.unit}`;
};
const formatRoicValue = (value: any) => {
  if (value.unit === '%') return `${Number(value.value).toLocaleString('ja-JP', { maximumFractionDigits: 2 })}%`;
  return `${Number(value.value).toLocaleString('ja-JP', { maximumFractionDigits: 1 })} ${value.unit}`;
};
---
<BaseLayout title={d.japaneseName || d.name} description={d.summary} indexable>
  <article>
    <span hidden data-pagefind-filter={`layer:${d.primaryLayer}`}></span>
    <span hidden data-pagefind-filter={`country:${d.country}`}></span>
    <span hidden data-pagefind-meta={`ticker:${d.ticker}`}></span>

    <div class="shell company-hero">
      <div>
        <div class="breadcrumb"><a href={withBase('companies/')}>企業一覧</a> / {layerLabel(d.primaryLayer)}</div>
        <div class="company-heading-wrap">
          {brandAsset?.displayAllowed && brandAsset.assetUrl ? <img class="company-logo" src={brandAsset.assetUrl} alt={`${d.name} ロゴ`} /> : null}
          <div>
            <div class="company-title-line"><h1>{d.japaneseName || d.name}</h1></div>
            <div class="company-meta-line"><span class="mono">{d.ticker}</span><span>·</span><span>{d.exchange}</span><span>·</span><a href={`${withBase('companies/')}?country=${encodeURIComponent(d.country)}`}>{countryLabel(d.country)}</a></div>
            <div class="company-ja">{d.officialName} · 読み：{d.reading}</div>
          </div>
        </div>
        <div class="tags tag-links" aria-label="技術タグ">
          {d.tags.map(tag => <a class="tag-link" href={`${withBase('companies/')}?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>)}
        </div>
      </div>
      <dl class="snapshot">
        <div class="snapshot-row"><dt>主領域</dt><dd><a class="text-link" href={`${withBase('companies/')}?layer=${encodeURIComponent(d.primaryLayer)}`}>{layerLabel(d.primaryLayer)}</a></dd></div>
        <div class="snapshot-row"><dt>情報確認状況</dt><dd>{statusLabels[d.sourceStatus] ?? d.sourceStatus}</dd></div>
        <div class="snapshot-row"><dt>最終確認日</dt><dd class="mono">{d.lastReviewed}</dd></div>
      </dl>
    </div>

    <div class="shell detail-grid section">
      <div class="company-research">
        <section class="company-section" id="overview">
          <div class="section-classification">分類：編集情報</div>
          <h2>概要</h2>
          <p class="lead">{d.summary}</p>
        </section>

        <section class="company-section" id="position">
          <div class="section-classification">分類：分析</div>
          <h2>バリューチェーン上の位置</h2>
          <p>{d.aiRole}</p>
        </section>

        <section class="company-section" id="products">
          <div class="section-classification">分類：企業・製品情報</div>
          <h2>主力製品</h2>
          <dl class="product-list">
            {d.products.map(product => {
              const info = productInfo(product);
              return <div class="product-row"><dt>{info.label}</dt><dd>{info.description}</dd></div>;
            })}
          </dl>
        </section>

        <section class="company-section" id="advantages">
          <div class="section-classification">分類：分析</div>
          <h2>競争優位</h2>
          <div class="editorial-paragraphs">
            {d.strengths.map(item => <p>{item}。</p>)}
          </div>
        </section>

        {companyFacilities.length > 0 && (
          <section class="company-section" id="facilities">
            <div class="section-classification">分類：一次資料</div>
            <h2>主要拠点</h2>
            <p class="section-intro">一次情報で確認できた主要製造・研究拠点のみ掲載しています。全拠点の網羅表ではありません。</p>
            <div class="table-scroll">
              <table class="metrics-table facilities-table">
                <thead><tr><th>拠点</th><th>所在地</th><th>種別</th><th>主な役割</th></tr></thead>
                <tbody>
                  {companyFacilities.map(facility => {
                    const source = sourceById.get(facility.sourceId);
                    return (
                      <tr>
                        <td>{facility.name}</td>
                        <td>{facility.city} · <a class="text-link" href={`${withBase('companies/')}?q=${encodeURIComponent(facility.region)}`}>{facility.region}</a><br /><span class="table-muted">{countryLabel(facility.country)}</span></td>
                        <td>{facilityTypeLabel(facility.facilityType)}</td>
                        <td>{facility.role}{source ? <span class="metric-provenance"><a class="source-link" href={source.url} target="_blank" rel="noreferrer">一次資料 ↗</a></span> : null}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <section class="company-section" id="financials">
          <div class="section-classification">分類：客観データ</div>
          <h2>財務</h2>
          <p class="section-intro">出典・基準日・決算期間・定義が揃った数字だけを掲載します。欠損は0ではなくN/Aです。</p>
          <div class="table-scroll">
            <table class="metrics-table provenance-table">
              <thead><tr><th>指標</th><th>値</th><th>基準日・決算期間</th><th>出典・定義</th></tr></thead>
              <tbody>
                {Object.entries(d.metrics).map(([key, metric]) => {
                  const source = metric.sourceId ? sourceById.get(metric.sourceId) : undefined;
                  return (
                    <tr>
                      <th>{metricLabels[key]}</th>
                      <td class="provenance-value">{formatMetric(metric)}</td>
                      <td class="provenance-detail">{metric.value === null ? '—' : <>{metric.asOf}<br />{metric.period}</>}</td>
                      <td class="provenance-detail">
                        {metric.value === null ? '未掲載' : <>{metric.calculationId ? <span class="source-kind">Atlas算出</span> : <span class="source-kind">一次資料</span>}<br />{metric.basis}{source ? <><br /><a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a></> : null}{metric.calculationId ? <><br /><a class="text-link" href="#roic-calculation">計算根拠を見る</a></> : null}</>}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        {companyRoic && (
          <section class="company-section" id="roic-calculation">
            <div class="section-classification">分類：Atlas算出</div>
            <h2>ROIC計算根拠</h2>
            <p class="section-intro">{companyRoic.period} · 単位 {companyRoic.currency}。一次財務諸表の入力値からAtlas側で再計算しています。</p>
            <div class="table-scroll">
              <table class="metrics-table">
                <tbody>
                  <tr><th>実効税率</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.effectiveTaxRate)}</td></tr>
                  <tr><th>NOPAT</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.nopat)}</td></tr>
                  <tr><th>期首投下資本</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.beginningInvestedCapital)}</td></tr>
                  <tr><th>期末投下資本</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.endingInvestedCapital)}</td></tr>
                  <tr><th>平均投下資本</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.averageInvestedCapital)}</td></tr>
                  <tr><th>ROIC</th><td class="provenance-value"><strong>{formatRoicValue(companyRoic.outputs.roic)}</strong></td></tr>
                </tbody>
              </table>
            </div>
            <details class="calculation-details">
              <summary>入力値と一次資料を確認</summary>
              <div class="table-scroll">
                <table class="metrics-table">
                  <tbody>
                    {Object.entries(companyRoic.inputs).map(([name, input]: [string, any]) => (
                      <tr>
                        <th>{name}</th>
                        <td class="provenance-value">{formatRoicValue(input)}</td>
                        <td class="provenance-detail">{input.period}<br />{input.basis}{input.sourceIds.map((sourceId: string) => { const source = sourceById.get(sourceId); return source ? <><br /><a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a></> : null; })}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </section>
        )}

        {companyKpis.length > 0 && (
          <section class="company-section" id="kpi">
            <div class="section-classification">分類：客観データ</div>
            <h2>業種固有KPI</h2>
            <p class="section-intro">共通財務指標だけでは見えにくい、事業固有の重要数字です。</p>
            <div class="table-scroll">
              <table class="metrics-table provenance-table">
                <thead><tr><th>指標</th><th>値</th><th>基準日・決算期間</th><th>出典・定義</th></tr></thead>
                <tbody>
                  {companyKpis.map(kpi => {
                    const definition = kpiDefinitionById.get(kpi.definitionId);
                    const source = sourceById.get(kpi.sourceId);
                    return (
                      <tr>
                        <th>{definition?.name ?? kpi.definitionId}</th>
                        <td class="provenance-value">{formatKpi(kpi)}</td>
                        <td class="provenance-detail">{kpi.asOf}<br />{kpi.period}</td>
                        <td class="provenance-detail"><span class="source-kind">一次資料</span><br />{definition?.description || kpi.basis}{source ? <><br /><a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a></> : null}</td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </section>
        )}

        <section class="company-section" id="competitors">
          <div class="section-classification">分類：比較対象</div>
          <h2>競合・比較対象</h2>
          {peers.length ? <div class="link-list">{peers.map(peer => <a class="text-link" href={withBase(`companies/${peer.id}/`)}>{peer.data.japaneseName || peer.data.name}</a>)}</div> : <p>一次情報の検証待ちです。</p>}
        </section>

        <section class="company-section" id="risks">
          <div class="section-classification">分類：分析</div>
          <h2>リスク・確認点</h2>
          <div class="editorial-paragraphs">
            {d.risks.map(item => <p>{item}。</p>)}
          </div>
        </section>

        <section class="company-section" id="sources">
          <div class="section-classification">分類：証拠管理</div>
          <h2>出典</h2>
          <div class="table-scroll">
            <table class="source-table">
              <thead><tr><th>区分</th><th>資料</th><th>発行元</th><th>確認日</th></tr></thead>
              <tbody>
                {companySources.map(source => (
                  <tr>
                    <td class="source-kind">一次資料</td>
                    <td><a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a></td>
                    <td>{source.publisher}</td>
                    <td class="mono">{source.retrievedAt}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p class="meta" style="margin-top:10px">最終確認日：<span class="mono">{d.lastReviewed}</span></p>
        </section>
      </div>

      <aside class="company-sidebar" aria-label="企業ページ内ナビゲーション">
        <section class="sidebar-section">
          <h3>このページ</h3>
          <nav class="report-toc">
            <a href="#overview">概要</a>
            <a href="#position">バリューチェーン上の位置</a>
            <a href="#products">主力製品</a>
            <a href="#advantages">競争優位</a>
            {companyFacilities.length > 0 ? <a href="#facilities">主要拠点</a> : null}
            <a href="#financials">財務</a>
            {companyKpis.length > 0 ? <a href="#kpi">業種固有KPI</a> : null}
            <a href="#competitors">競合</a>
            <a href="#risks">リスク</a>
            <a href="#sources">出典</a>
          </nav>
        </section>
        <section class="sidebar-section">
          <h3>所属領域</h3>
          <div class="link-list">{d.layers.map(layer => <a class="text-link" href={`${withBase('companies/')}?layer=${encodeURIComponent(layer)}`}>{layerLabel(layer)}</a>)}</div>
        </section>
      </aside>
    </div>
  </article>
</BaseLayout>
