---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompanyEvidenceClaims from '../../components/CompanyEvidenceClaims.astro';
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/paths';
import { layerLabel, countryLabel, tagLabel, facilityTypeLabel, productInfo } from '../../lib/display-v02';
import { getMetricAudit, getMetricState, formatMetricValue, auditFormula } from '../../lib/metrics';
import sources from '../../data/sources.json';
import v02Sources from '../../data/sources-v02.json';
import documentSources from '../../data/document-sources.json';
import pilotDocumentSources from '../../data/document-sources-pilot-v01.json';
import facilitySources from '../../data/facility-sources.json';
import facilities from '../../data/facilities.json';
import brandAssets from '../../data/brand-assets.json';
import claims from '../../data/claims.json';
import sectorKpis from '../../data/sector-kpis.json';
import sectorKpiDefinitions from '../../data/sector-kpi-definitions.json';
import roicCalculations from '../../data/roic-calculations.json';
import metricDefinitions from '../../data/metric-definitions.json';
import companyEvidencePilot from '../../data/company-evidence-pilot-v01.json';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map(company => ({ params: { id: company.id }, props: { company } }));
}

const { company } = Astro.props;
const d = company.data;
const allCompanies = await getCollection('companies');
const allSources = [...sources, ...v02Sources, ...documentSources, ...facilitySources, ...pilotDocumentSources];
const sourceById = new Map(allSources.map(source => [source.id, source]));
const metricDefinitionById = new Map(metricDefinitions.map(definition => [definition.id, definition]));
const peerIds = new Set<string>(d.competitors);
for (const candidate of allCompanies) {
  if (candidate.id !== company.id && candidate.data.competitors.includes(company.id)) peerIds.add(candidate.id);
}
const peers = [...peerIds].map(id => allCompanies.find(c => c.id === id)).filter(Boolean);
const companyFacilities = facilities.filter(facility => facility.companyId === company.id);
const facilitySourceIds = new Set(companyFacilities.map(facility => facility.sourceId));
const companyClaims = claims.filter(claim => claim.companyId === company.id);
const claimSourceIds = new Set(companyClaims.flatMap(claim => claim.sourceIds));
const pilotCompanyIds = new Set(['nvidia', 'tsmc', 'applied-materials', 'fujikura', 'vertiv']);
const isEvidencePilot = pilotCompanyIds.has(company.id);
const pilotClaims = isEvidencePilot ? companyEvidencePilot.claims.filter(claim => claim.companyId === company.id) : [];
const pilotEvidenceIds = new Set(pilotClaims.flatMap(claim => claim.evidenceIds));
const pilotEvidence = companyEvidencePilot.evidence.filter(binding => pilotEvidenceIds.has(binding.id));
const pilotCoverage = isEvidencePilot ? companyEvidencePilot.coverage.filter(item => item.companyId === company.id) : [];
const pilotSourceIds = new Set(pilotEvidence.map(binding => binding.sourceId));
const companySources = allSources.filter(source => d.sourceIds.includes(source.id) || facilitySourceIds.has(source.id) || claimSourceIds.has(source.id) || pilotSourceIds.has(source.id));
const brandAsset = brandAssets.find(asset => asset.companyId === company.id);
const companyKpis = sectorKpis.filter(kpi => kpi.companyId === company.id);
const companyRoic = roicCalculations.find(calc => calc.companyId === company.id && d.metrics.roic.calculationId === calc.id);
const kpiDefinitionById = new Map(sectorKpiDefinitions.map(definition => [definition.id, definition]));
const metricLabels: Record<string, string> = {
  peTTM:'PER（実績）', peFY1:'PER（予想1期先）', pb:'PBR', roic:'ROIC',
  operatingMargin:'営業利益率', revenueGrowth:'売上高成長率（前年同期比）'
};
const statusLabels: Record<string, string> = { verified:'検証済み', partial:'一部検証済み', placeholder:'未検証' };
const claimTypeLabels: Record<string,string> = { fact:'事実', analysis:'分析', estimate:'推定' };

const formatKpi = (kpi: any) => {
  const value = Number(kpi.value);
  if (kpi.unit === '%') return `${value.toLocaleString('ja-JP', { maximumFractionDigits: 2 })}%`;
  if (kpi.unit === 'USD bn') return `${value.toLocaleString('ja-JP', { maximumFractionDigits: 3 })}十億ドル`;
  if (kpi.unit === 'EUR bn') return `${value.toLocaleString('ja-JP', { maximumFractionDigits: 3 })}十億ユーロ`;
  if (kpi.unit === 'JPY bn') return `${(value * 10).toLocaleString('ja-JP', { maximumFractionDigits: 1 })}億円`;
  if (kpi.unit === 'systems') return `${value.toLocaleString('ja-JP')}台`;
  if (kpi.unit === 'connections') return `${value.toLocaleString('ja-JP')}件`;
  if (kpi.unit === 'fibers') return `${value.toLocaleString('ja-JP')}心`;
  return `${value.toLocaleString('ja-JP')} ${kpi.unit}`;
};
const formatRoicValue = (value: any) => {
  if (value.unit === '%') return `${Number(value.value).toLocaleString('ja-JP', { maximumFractionDigits: 2 })}%`;
  return `${Number(value.value).toLocaleString('ja-JP', { maximumFractionDigits: 1 })} ${value.unit}`;
};
const toc = [
  ['overview','概要'],['position','バリューチェーン'],['products','主力製品'],['evidence','主張と根拠'],['advantages','競争優位'],
  ['facilities','主要拠点'],['financials','財務'],['kpi','業種固有KPI'],['competitors','競合'],['risks','リスク'],['sources','出典']
].filter(([id]) => {
  if (id === 'evidence') return !isEvidencePilot && companyClaims.length > 0;
  if (id === 'facilities') return isEvidencePilot || companyFacilities.length > 0;
  if (id === 'kpi') return companyKpis.length > 0;
  return true;
});
---
<BaseLayout title={d.japaneseName || d.name} description={d.summary} indexable>
  <article class={`sector-page sector-${d.primaryLayer.replace(/[^a-zA-Z]/g,'-').toLowerCase()}`}>
    <span hidden data-pagefind-filter={`layer:${d.primaryLayer}`}></span>
    <span hidden data-pagefind-filter={`country:${d.country}`}></span>
    {d.ticker ? <span hidden data-pagefind-meta={`ticker:${d.ticker}`}></span> : null}

    <div class="shell company-hero">
      <div>
        <div class="breadcrumb"><a href={withBase('companies/')}>企業一覧</a> / {layerLabel(d.primaryLayer)}</div>
        <div class="company-heading-wrap">
          {brandAsset?.displayAllowed && brandAsset.assetUrl ? <img class="company-logo" src={brandAsset.assetUrl} alt={`${d.name} ロゴ`} /> : null}
          <div>
            <div class="company-title-line"><h1>{d.japaneseName || d.name}</h1></div>
            <div class="company-meta-line">
              {d.ticker ? <><span class="mono">{d.ticker}</span><span>·</span><span>{d.exchange}</span><span>·</span></> : <><span>非上場</span><span>·</span></>}
              <a href={`${withBase('companies/')}?country=${encodeURIComponent(d.country)}`}>{countryLabel(d.country)}</a>
            </div>
            <div class="company-ja">{d.officialName} · 読み：{d.reading}</div>
          </div>
        </div>
        <div class="tags tag-links" aria-label="技術タグ">
          {d.tags.map(tag => <a class="tag-link" href={`${withBase('companies/')}?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>)}
        </div>
      </div>
      <dl class="snapshot">
        <div class="snapshot-row"><dt>主領域</dt><dd><a class="text-link" href={`${withBase('companies/')}?layer=${encodeURIComponent(d.primaryLayer)}`}>{layerLabel(d.primaryLayer)}</a></dd></div>
        <div class="snapshot-row"><dt>情報確認状況</dt><dd>{statusLabels[d.sourceStatus] ?? d.sourceStatus}</dd></div>
        <div class="snapshot-row"><dt>最終確認日</dt><dd class="mono">{d.lastReviewed}</dd></div>
      </dl>
    </div>

    <div class="shell detail-grid section">
      <div class="company-research">
        <section class="company-section" id="overview">
          <div class="section-classification">編集情報</div>
          <h2>概要</h2>
          {isEvidencePilot
            ? <CompanyEvidenceClaims claims={pilotClaims} evidence={pilotEvidence} sources={companySources} coverage={pilotCoverage} categories={['company-overview']} />
            : <p class="lead">{d.summary}</p>}
        </section>

        <section class="company-section" id="position">
          <div class="section-classification analysis-label">分析</div>
          <h2>バリューチェーン上の位置</h2>
          {isEvidencePilot
            ? <CompanyEvidenceClaims claims={pilotClaims} evidence={pilotEvidence} sources={companySources} coverage={pilotCoverage} categories={['ai-infrastructure-role','value-chain-position']} />
            : <p>{d.aiRole}</p>}
        </section>

        <section class="company-section" id="products">
          <div class="section-classification">企業・製品情報</div>
          <h2>主力製品</h2>
          {isEvidencePilot
            ? <CompanyEvidenceClaims claims={pilotClaims} evidence={pilotEvidence} sources={companySources} coverage={pilotCoverage} categories={['products','technology','customer-end-market']} />
            : <dl class="product-list">
            {d.products.map(product => { const info = productInfo(product); return <div class="product-row"><dt>{info.label}</dt><dd>{info.description}</dd></div>; })}
          </dl>}
        </section>

        {companyClaims.length > 0 && (
          <section class="company-section" id="evidence">
            <div class="section-classification">根拠管理</div>
            <h2>主張と根拠</h2>
            <div class="claim-list">
              {companyClaims.map(claim => (
                <article class="claim-row">
                  <div class={`claim-type claim-${claim.type}`}>{claimTypeLabels[claim.type] || claim.type}</div>
                  <div>
                    <h3>{claim.title}</h3>
                    <p>{claim.statement}</p>
                    <div class="claim-sources">{claim.sourceIds.map(sourceId => { const source = sourceById.get(sourceId); return source ? <a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a> : null; })}</div>
                  </div>
                </article>
              ))}
            </div>
          </section>
        )}

        <section class="company-section" id="advantages">
          <div class="section-classification analysis-label">分析</div>
          <h2>競争優位</h2>
          {isEvidencePilot
            ? <CompanyEvidenceClaims claims={pilotClaims} evidence={pilotEvidence} sources={companySources} coverage={pilotCoverage} categories={['competitive-positioning','strategy']} />
            : <ul class="research-list">{d.strengths.map(item => <li>{item}</li>)}</ul>}
        </section>

        {(isEvidencePilot || companyFacilities.length > 0) && (
          <section class="company-section" id="facilities">
            <div class="section-classification">一次資料</div>
            <h2>主要拠点</h2>
            {isEvidencePilot && <CompanyEvidenceClaims claims={pilotClaims} evidence={pilotEvidence} sources={companySources} coverage={pilotCoverage} categories={['manufacturing-facilities','capacity-expansion']} />}
            {companyFacilities.length > 0 && <><p class="section-intro">一次情報で確認できた主要製造・研究拠点のみ掲載しています。全拠点の網羅表ではありません。</p>
            <div class="table-scroll">
              <table class="metrics-table facilities-table">
                <thead><tr><th>拠点</th><th>所在地</th><th>種別</th><th>主な役割</th></tr></thead>
                <tbody>
                  {companyFacilities.map(facility => { const source = sourceById.get(facility.sourceId); return <tr><td>{facility.name}</td><td>{facility.city} · <a class="text-link" href={`${withBase('companies/')}?q=${encodeURIComponent(facility.region)}`}>{facility.region}</a><br /><span class="table-muted">{countryLabel(facility.country)}</span></td><td>{facilityTypeLabel(facility.facilityType)}</td><td>{facility.role}{source ? <span class="metric-provenance"><a class="source-link" href={source.url} target="_blank" rel="noreferrer">一次資料 ↗</a></span> : null}</td></tr>; })}
                </tbody>
              </table>
            </div></>}
          </section>
        )}

        <section class="company-section" id="financials">
          <div class="section-classification">客観データ</div>
          <h2>財務</h2>
          <p class="section-intro">値だけでなく、決算期間・基準日・定義・一次資料・検証状態を一体で表示します。欠損も理由を隠しません。</p>
          <div class="table-scroll">
            <table class="metrics-table financial-audit-table">
              <thead><tr><th>指標</th><th>値</th><th>決算期間・基準日</th><th>計算式・定義</th><th>一次資料</th><th>検証状態</th></tr></thead>
              <tbody>
                {Object.entries(d.metrics).map(([key, metric]) => {
                  const source = metric.sourceId ? sourceById.get(metric.sourceId) : undefined;
                  const audit = getMetricAudit(company.id, key);
                  const calcVerified = key === 'roic' && companyRoic?.status === 'verified';
                  const state = getMetricState(company.id, key, metric, calcVerified);
                  const definition = metricDefinitionById.get(metric.definitionId);
                  const formula = auditFormula(audit);
                  const value = formatMetricValue(metric);
                  return (
                    <tr>
                      <th>{metricLabels[key]}</th>
                      <td class="provenance-value">{value ?? state.label}</td>
                      <td class="provenance-detail">{metric.value == null ? '—' : <>{metric.period}<br /><span class="table-muted">基準日 {metric.asOf}</span></>}</td>
                      <td class="provenance-detail">{metric.value == null ? '—' : <>{formula || metric.basis}<br /><span class="table-muted">定義：{definition?.definition || metric.definitionId}</span></>}</td>
                      <td class="provenance-detail">{source ? <a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a> : metric.calculationId ? <a class="text-link" href="#roic-calculation">Atlas計算根拠</a> : '—'}</td>
                      <td><span class={`metric-state metric-state-${state.kind}`}>{state.label}</span>{audit ? <span class="metric-provenance">再検証日 {audit.verifiedAt}</span> : null}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </section>

        {companyRoic && (
          <section class="company-section" id="roic-calculation">
            <div class="section-classification">Atlas算出</div>
            <h2>ROIC計算根拠</h2>
            <p class="section-intro">{companyRoic.period} · 単位 {companyRoic.currency}。一次財務諸表の入力値からAtlas側で再計算しています。</p>
            <div class="table-scroll"><table class="metrics-table"><tbody>
              <tr><th>実効税率</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.effectiveTaxRate)}</td></tr>
              <tr><th>NOPAT</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.nopat)}</td></tr>
              <tr><th>期首投下資本</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.beginningInvestedCapital)}</td></tr>
              <tr><th>期末投下資本</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.endingInvestedCapital)}</td></tr>
              <tr><th>平均投下資本</th><td class="provenance-value">{formatRoicValue(companyRoic.outputs.averageInvestedCapital)}</td></tr>
              <tr><th>ROIC</th><td class="provenance-value"><strong>{formatRoicValue(companyRoic.outputs.roic)}</strong></td></tr>
            </tbody></table></div>
            <details class="calculation-details"><summary>入力値と一次資料を確認</summary><div class="table-scroll"><table class="metrics-table"><tbody>
              {Object.entries(companyRoic.inputs).map(([name, input]: [string, any]) => <tr><th>{name}</th><td class="provenance-value">{formatRoicValue(input)}</td><td class="provenance-detail">{input.period}<br />{input.basis}{input.sourceIds.map((sourceId: string) => { const source = sourceById.get(sourceId); return source ? <><br /><a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a></> : null; })}</td></tr>)}
            </tbody></table></div></details>
          </section>
        )}

        {companyKpis.length > 0 && (
          <section class="company-section" id="kpi">
            <div class="section-classification">客観データ</div>
            <h2>業種固有KPI</h2>
            <div class="table-scroll"><table class="metrics-table provenance-table"><thead><tr><th>指標</th><th>値</th><th>基準日・決算期間</th><th>一次資料・定義</th></tr></thead><tbody>
              {companyKpis.map(kpi => { const definition = kpiDefinitionById.get(kpi.definitionId); const source = sourceById.get(kpi.sourceId); return <tr><th>{definition?.name ?? kpi.definitionId}</th><td class="provenance-value">{formatKpi(kpi)}</td><td class="provenance-detail">{kpi.period}<br /><span class="table-muted">基準日 {kpi.asOf}</span></td><td class="provenance-detail">{definition?.description || kpi.basis}{source ? <><br /><a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a></> : null}</td></tr>; })}
            </tbody></table></div>
          </section>
        )}

        <section class="company-section" id="competitors"><div class="section-classification">比較対象</div><h2>競合</h2>{peers.length ? <div class="link-list">{peers.map(peer => <a class="text-link" href={withBase(`companies/${peer.id}/`)}>{peer.data.japaneseName || peer.data.name}</a>)}</div> : <p>競合関係は一次資料の確認後に追加します。</p>}</section>

        <section class="company-section" id="risks"><div class="section-classification analysis-label">分析</div><h2>リスク・確認点</h2>{isEvidencePilot ? <CompanyEvidenceClaims claims={pilotClaims} evidence={pilotEvidence} sources={companySources} coverage={pilotCoverage} categories={['risks']} /> : <ul class="research-list">{d.risks.map(item => <li>{item}</li>)}</ul>}</section>

        <section class="company-section" id="sources"><div class="section-classification">証拠管理</div><h2>出典</h2><div class="source-table">{companySources.map(source => <div class="source-row"><span class="source-class">一次資料</span><a class="source-link" href={source.url} target="_blank" rel="noreferrer">{source.title} ↗</a><span class="table-muted">取得 {source.retrievedAt}</span></div>)}</div><p class="section-intro">最終確認日：{d.lastReviewed}</p></section>
      </div>

      <aside class="company-sidebar">
        <nav class="company-toc" aria-label="この企業ページの目次"><div class="toc-title">このページ</div>{toc.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</nav>
        <section class="sidebar-section"><h3>所属領域</h3><div class="tags">{d.layers.map(layer => <a class="tag-link" href={`${withBase('companies/')}?layer=${encodeURIComponent(layer)}`}>{layerLabel(layer)}</a>)}</div></section>
        <section class="sidebar-section"><h3>最終確認日</h3><p class="mono">{d.lastReviewed}</p></section>
      </aside>
    </div>
  </article>
  {isEvidencePilot && <script is:inline>
    (() => {
      const returnFocus = new WeakMap();
      document.querySelectorAll('[data-evidence-open]').forEach((trigger) => {
        trigger.addEventListener('click', () => {
          const dialog = document.getElementById(trigger.getAttribute('data-evidence-open'));
          if (!(dialog instanceof HTMLDialogElement)) return;
          returnFocus.set(dialog, trigger);
          dialog.showModal();
          dialog.querySelector('[data-evidence-close]')?.focus();
        });
      });
      document.querySelectorAll('.evidence-drawer').forEach((dialog) => {
        if (!(dialog instanceof HTMLDialogElement)) return;
        dialog.querySelector('[data-evidence-close]')?.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
        dialog.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            event.preventDefault();
            dialog.close();
          }
        });
        dialog.addEventListener('close', () => returnFocus.get(dialog)?.focus());
      });
    })();
  </script>}
</BaseLayout>
