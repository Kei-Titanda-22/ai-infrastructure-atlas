---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import layers from '../data/layers.json';
import { withBase } from '../lib/paths';
import { layerLabel } from '../lib/display';
const companies = await getCollection('companies');
---
<BaseLayout title="全体マップ" indexable>
  <header class="page-head">
    <div class="shell">
      <div class="eyebrow">産業構造マップ</div>
      <h1>全体マップ</h1>
      <p class="lead">AI需要を、計算半導体だけでなく製造・記憶・接続・電力・冷却・現実空間まで辿ります。現在はレイヤー構造を表示し、検証済みの企業間関係を順次重ねていきます。</p>
    </div>
  </header>
  <div class="shell section">
    <div class="atlas-lanes">
      {layers.map((layer, index) => {
        const members = companies.filter(c => c.data.layers.includes(layer.name));
        return (
          <section class="atlas-lane">
            <div class="atlas-lane-head">
              <span class="num">レイヤー {String(index+1).padStart(2,'0')}</span>
              <h3>{layerLabel(layer.name)}</h3>
              <p>{layer.description}</p>
            </div>
            <div class="atlas-companies">
              {members.map(c => <a class="atlas-company" href={withBase(`companies/${c.id}/`)}>{c.data.japaneseName || c.data.name} <span class="ticker">{c.data.ticker}</span></a>)}
            </div>
          </section>
        )
      })}
    </div>
  </div>
</BaseLayout>
