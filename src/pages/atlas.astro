---
import BaseLayout from '../layouts/BaseLayout.astro';
import DisplayTerminologyHelper from '../components/DisplayTerminologyHelper.astro';
import valueChain from '../data/value-chain.json';
import { withBase } from '../lib/paths';

const stageHref = (stage: any) => stage.id === 'demand'
  ? `${withBase('companies/')}?q=${encodeURIComponent('AI')}`
  : `${withBase('companies/')}?stage=${encodeURIComponent(stage.id)}`;
const linkHref = (link: any) => link.technology
  ? `${withBase('companies/')}?technology=${encodeURIComponent(link.technology)}`
  : link.tag
    ? `${withBase('companies/')}?tag=${encodeURIComponent(link.tag)}`
    : `${withBase('companies/')}?q=${encodeURIComponent(link.query)}`;
---
<BaseLayout title="全体マップ" indexable pageClass="global-visual-pilot global-visual-atlas">
  <header class="page-head">
    <div class="shell">
      <span class="eyebrow">産業バリューチェーン</span>
      <h1>全体マップ</h1>
      <p class="lead">AI需要が、半導体・メモリ・製造工程・接続・データセンター設備へどう伝わるかを工程順に辿ります。工程名・技術名は企業一覧の絞り込みへ接続します。</p>
    </div>
  </header>

  <div class="shell section" data-terminology-scope>
    <div class="map-note">読み方：縦方向は需要・製品の流れを簡略化したものです。半導体製造装置はファウンドリとメモリ製造を支える「製造側の入力」であり、すべての工程が完全な直列関係にあることを意味しません。</div>
    <div class="value-chain-map" aria-label="AIインフラのバリューチェーン工程図">
      {valueChain.map((stage, index) => (
        <div class={`value-chain-stage vc-${stage.id}`}>
          <a class="value-chain-stage-head" href={stageHref(stage)}>
            <span class="value-chain-number">{stage.number}</span>
            <span class="value-chain-title">{stage.name}</span>
          </a>
          <p>{stage.description}</p>
          <div class="value-chain-links">
            {stage.links.map(link => <a href={linkHref(link)}>{link.label}</a>)}
          </div>
          {index < valueChain.length - 1 && <div class="value-chain-arrow" aria-hidden="true">↓</div>}
        </div>
      ))}
    </div>
    <DisplayTerminologyHelper />
  </div>
</BaseLayout>
