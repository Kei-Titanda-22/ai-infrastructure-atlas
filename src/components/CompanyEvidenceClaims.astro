---
import CompanyEvidenceClaim from './CompanyEvidenceClaim.astro';

interface Props {
  claims: any[];
  evidence: any[];
  sources: any[];
  coverage?: any[];
  categories: string[];
  priorities?: string[];
  showCoverage?: boolean;
  coverageMode?: 'disclosure' | 'static';
  flattenSecondary?: boolean;
  compact?: boolean;
  sourceNumberById?: Record<string, number>;
}

const {
  claims,
  evidence,
  sources,
  coverage = [],
  categories,
  priorities = ['P1', 'P2', 'P3'],
  showCoverage = true,
  coverageMode = 'disclosure',
  flattenSecondary = false,
  compact = false,
  sourceNumberById = {},
} = Astro.props;

const selectedClaims = claims.filter(claim => categories.includes(claim.category) && priorities.includes(claim.priority));
const primaryClaims = selectedClaims.filter(claim => claim.priority === 'P1');
const secondaryClaims = selectedClaims.filter(claim => claim.priority !== 'P1');
const relevantCoverage = coverage.filter(item => categories.includes(item.category) && item.collectionStatus !== 'complete');

const categoryLabels: Record<string, string> = {
  'company-overview': '企業概要',
  'ai-infrastructure-role': 'AIインフラ上の役割',
  products: '製品',
  technology: '技術',
  'value-chain-position': 'バリューチェーン',
  'manufacturing-facilities': '製造・拠点',
  'capacity-expansion': '能力・増強',
  'customer-end-market': '顧客・用途市場',
  'competitive-positioning': '競争上の位置付け',
  strategy: '戦略',
  risks: 'リスク',
};
const missingLabels: Record<string, string> = {
  'not-collected': '未収集',
  'primary-source-unchecked': '一次資料未確認',
  'not-disclosed': '非開示',
  'not-applicable': '対象外',
};
const coverageLabel = (item: any) => item.collectionStatus === 'partial'
  ? `一部収録${item.missingStatus ? `・${missingLabels[item.missingStatus]}` : ''}`
  : missingLabels[item.missingStatus] ?? '未収集';
const partialCount = relevantCoverage.filter(item => item.collectionStatus === 'partial').length;
const missingCount = relevantCoverage.filter(item => item.collectionStatus === 'not-started').length;
const coverageSummary = [partialCount ? `一部収録 ${partialCount}` : '', missingCount ? `未収集 ${missingCount}` : ''].filter(Boolean).join(' / ');
---

{(selectedClaims.length > 0 || (showCoverage && relevantCoverage.length > 0)) && (
  <div class:list={['pilot-claims', { 'pilot-claims-compact': compact }]} data-company-evidence-claims>
    {primaryClaims.length > 0 && (
      <div class="pilot-claim-stack">
        {primaryClaims.map(claim => <CompanyEvidenceClaim claim={claim} evidence={evidence} sources={sources} compact={compact} sourceNumberById={sourceNumberById} />)}
      </div>
    )}
    {secondaryClaims.length > 0 && flattenSecondary && (
      <div class="pilot-claim-stack secondary-stack pilot-claim-stack-flat">
        {secondaryClaims.map(claim => <CompanyEvidenceClaim claim={claim} evidence={evidence} sources={sources} compact={false} staticProvenance sourceNumberById={sourceNumberById} />)}
      </div>
    )}
    {secondaryClaims.length > 0 && !flattenSecondary && (
      <details class="secondary-claims">
        <summary>詳細を見る <span>{secondaryClaims.length}件</span></summary>
        <div class="pilot-claim-stack secondary-stack">
          {secondaryClaims.map(claim => <CompanyEvidenceClaim claim={claim} evidence={evidence} sources={sources} compact={false} sourceNumberById={sourceNumberById} />)}
        </div>
      </details>
    )}
    {showCoverage && relevantCoverage.length > 0 && coverageMode === 'disclosure' && (
      <details class="coverage-notices" data-coverage-notice>
        <summary>収録状況：{coverageSummary}</summary>
        <div class="coverage-notice-list">
          {relevantCoverage.map(item => (
            <p><strong>{categoryLabels[item.category]}</strong><span>{coverageLabel(item)}</span>{item.notes && <small>{item.notes}</small>}</p>
          ))}
        </div>
      </details>
    )}
    {showCoverage && relevantCoverage.length > 0 && coverageMode === 'static' && (
      <div class="coverage-notice-list coverage-notice-list-static" data-coverage-notice>
        {relevantCoverage.map(item => (
          <p><strong>{categoryLabels[item.category]}</strong><span>{coverageLabel(item)}</span>{item.notes && <small>{item.notes}</small>}</p>
        ))}
      </div>
    )}
  </div>
)}

<style>
  .pilot-claim-stack{display:grid;gap:0}.pilot-claim-stack>:global(.pilot-claim)+:global(.pilot-claim){margin-top:.65rem;padding-top:.8rem;border-top:1px solid var(--line,#d8dee7)}.secondary-claims{margin-top:.75rem;padding:.65rem 0;border-top:1px solid var(--line,#d8dee7);border-bottom:1px solid var(--line,#d8dee7)}.secondary-claims>summary,.coverage-notices>summary{width:fit-content;cursor:pointer;color:var(--link,#0057b8);font-size:.79rem;font-weight:700;text-decoration:underline}.secondary-claims>summary span{font-weight:400;color:var(--muted,#667)}.secondary-stack{margin-top:.8rem}.coverage-notices{margin-top:.7rem;padding:.6rem 0;border-top:1px solid #c5cbd1;border-bottom:1px solid #c5cbd1}.coverage-notices>summary{color:#4a5966;text-decoration:none}.coverage-notice-list{display:grid;gap:.4rem;margin-top:.65rem}.coverage-notice-list-static{margin-top:.25rem}.coverage-notice-list p{display:grid;grid-template-columns:minmax(7.5rem,auto) 1fr;gap:.15rem .65rem;margin:0;font-size:.78rem}.coverage-notice-list small{grid-column:2;color:var(--muted,#667);font-size:.74rem}.pilot-claims-compact .pilot-claim-stack{gap:0}
  @media(max-width:600px){.coverage-notice-list p{grid-template-columns:1fr}.coverage-notice-list small{grid-column:1}}
</style>
