---
import { withBase } from '../lib/paths';
import { layerLabel, countryLabel } from '../lib/display';
const { company } = Astro.props;
const d = company.data ?? company;
const id = company.id;
---
<a
  class="company-card"
  href={withBase(`companies/${id}/`)}
  data-company-card
  data-name={`${d.name} ${d.japaneseName} ${d.reading} ${d.ticker} ${d.tags.join(' ')} ${d.products.join(' ')}`.toLowerCase()}
  data-layer={d.primaryLayer}
  data-country={d.country}
>
  <div class="company-card-top">
    <div>
      <h3>{d.japaneseName || d.name}</h3>
      <span class="meta">{d.name}</span>
    </div>
    <span class="ticker">{d.ticker}</span>
  </div>
  <p>{d.summary}</p>
  <div class="tags">
    <span class="tag">{layerLabel(d.primaryLayer)}</span>
    <span class="tag">AI感応度 {d.scores.aiExposure.value}/5</span>
    <span class="tag">{countryLabel(d.country)}</span>
  </div>
</a>
