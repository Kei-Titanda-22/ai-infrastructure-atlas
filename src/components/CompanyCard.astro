---
import { withBase } from '../lib/paths';
import { layerLabel, countryLabel, tagLabel } from '../lib/display';
import facilities from '../data/facilities.json';
const { company } = Astro.props;
const d = company.data ?? company;
const id = company.id;
const companyFacilities = facilities.filter(facility => facility.companyId === id);
const locationText = companyFacilities.map(facility => `${facility.city} ${facility.region}`).join(' ');
---
<article
  class="company-card"
  data-company-card
  data-name={`${d.name} ${d.japaneseName} ${d.reading} ${d.ticker} ${d.tags.join(' ')} ${d.products.join(' ')} ${locationText}`.toLowerCase()}
  data-tags={d.tags.join('|')}
  data-layer={d.primaryLayer}
  data-country={d.country}
>
  <div class="company-card-top">
    <div>
      <h3><a class="company-link" href={withBase(`companies/${id}/`)}>{d.japaneseName || d.name}</a></h3>
      <span class="meta">{d.name}</span>
    </div>
    <span class="ticker">{d.ticker}</span>
  </div>
  <p>{d.summary}</p>
  <div class="card-meta-line">
    <a class="filter-link" href={`${withBase('companies/')}?layer=${encodeURIComponent(d.primaryLayer)}`}>{layerLabel(d.primaryLayer)}</a>
    <span>·</span>
    <a class="filter-link" href={`${withBase('companies/')}?country=${encodeURIComponent(d.country)}`}>{countryLabel(d.country)}</a>
  </div>
  <div class="tags tag-links" aria-label="企業タグ">
    {d.tags.slice(0, 4).map(tag => (
      <a class="tag tag-link" href={`${withBase('companies/')}?tag=${encodeURIComponent(tag)}`}>{tagLabel(tag)}</a>
    ))}
  </div>
</article>
