---
import CompanyCompareEvidenceClaim from './CompanyCompareEvidenceClaim.astro';
import {
  buildCompanyCompareEvidenceReadModel,
  compareEvidenceDimensionLabels,
  type CompareEvidenceRelationEntry,
} from '../lib/company-compare-evidence-read-model';
import {
  selectCompareSummaryClaimIds,
  selectCompareSummaryRelationIds,
} from '../lib/company-compare-display';
import {
  companyCompareAssetSchemaVersion,
  resolveCompanyCompareProductPortfolioSummary,
} from '../lib/company-compare-evidence-assets';
import { deriveEvidenceFreshness } from '../lib/evidence-freshness';

type CompareEvidenceModel = ReturnType<typeof buildCompanyCompareEvidenceReadModel>;
type CompareEvidenceCompany = CompareEvidenceModel['companies'][number];

interface Props {
  company: CompareEvidenceCompany;
  operatingMarginReference: any;
  sourceNumberById: Record<string, number>;
}

const { company, operatingMarginReference, sourceNumberById } = Astro.props;
const presentationDimensionIds = ['ai-role', 'key-products', 'technology-moat', 'capacity-roadmap', 'key-risks'];
const sourceDimensionIds = (dimensionId: string) => dimensionId === 'ai-role'
  ? ['ai-role', 'value-chain-position']
  : [dimensionId];
const presentationFor = (dimensionId: string) => {
  const sections = sourceDimensionIds(dimensionId).map(sourceDimensionId => {
    const dimension = company.dimensions.find(item => item.dimensionId === sourceDimensionId)!;
    return { ...dimension, label: compareEvidenceDimensionLabels[sourceDimensionId] };
  });
  return {
    sections,
    claims: sections.flatMap(section => section.claims),
    relations: sections.flatMap(section => section.relations),
    hasContent: sections.some(section => section.claims.length + section.relations.length > 0),
    missingState: sections.every(section => section.missingState === sections[0]?.missingState)
      ? sections[0]?.missingState
      : 'not-collected',
  };
};
const freshnessLabels: Record<string, string> = {
  current: '確認期限内',
  'review-due': '再確認時期',
  stale: '確認期限超過',
};
const claimTypeGroups = (claims: any[], relations: CompareEvidenceRelationEntry[]) => {
  const types = [...claims.map(entry => entry.claim.claimType), ...relations.map(entry => entry.relation.claimType)];
  return {
    fact: types.some(type => type === 'fact'),
    company: types.some(type => type === 'company-guidance' || type === 'company-positioning'),
    analysis: types.some(type => type === 'atlas-analysis' || type === 'estimate'),
  };
};
const relationTypeLabels: Record<string, string> = {
  PRODUCES: '製品カテゴリ',
  POSITIONED_IN: '供給網上の位置',
  COMPETES_WITH: '競合関係',
};
const relationAsClaim = (entry: CompareEvidenceRelationEntry) => ({
  id: `compare-${entry.relation.relationId}-${company.identity.id}`,
  companyId: company.identity.id,
  category: 'relation',
  claimType: entry.relation.claimType,
  priority: entry.relation.importance,
  title: relationTypeLabels[entry.relation.relationType] ?? entry.relation.relationType,
  statement: entry.relation.statement,
  evidenceIds: [...entry.relation.evidenceIds],
  confidence: entry.relation.confidence ?? undefined,
  asOf: entry.relation.asOf,
  lastVerified: entry.relation.lastVerified,
  nextReview: entry.relation.nextReview,
});
const relationsForDisplay = (relations: CompareEvidenceRelationEntry[]) => {
  const canonicalProductIds = new Set<string>();
  return relations.filter(entry => {
    if (entry.relation.relationType !== 'PRODUCES') return true;
    if (canonicalProductIds.has(entry.relation.objectId)) return false;
    canonicalProductIds.add(entry.relation.objectId);
    return true;
  });
};
const claimBackedProductLabel = (canonicalId: string, fallback: string) => canonicalId === 'product-category-coater-developer-equipment'
  ? '塗布・現像装置'
  : fallback;
const missingLabels: Record<string, string> = {
  'not-collected': '未収録',
  'primary-source-unchecked': '一次資料未確認',
  'not-disclosed': '非開示',
  'not-applicable': '対象外',
  'not-missing': '収録済み',
};
const financialMetric = (record: any, metricId: string) => record.metrics.find((metric: any) => metric.metricId === metricId);
const companyContext = {
  id: company.identity.id,
  name: company.identity.displayName || company.identity.japaneseName || company.identity.name,
  accessibleName: company.identity.displayNameParts?.accessibleName || company.identity.name,
  primaryName: company.identity.displayNameParts?.primaryName || company.identity.name,
  secondaryName: company.identity.displayNameParts?.secondaryName || null,
  country: company.identity.displayCountry || company.identity.country,
};
---

<div
  data-company-compare-asset
  data-company-id={company.identity.id}
  data-schema-version={companyCompareAssetSchemaVersion}
  data-pagefind-ignore="all"
>
  <template data-company-slot="header">
    <a href={company.identity.href} aria-label={companyContext.accessibleName}><span class="compare-company-name" aria-hidden="true">{companyContext.primaryName}{companyContext.secondaryName && <small>{companyContext.secondaryName}</small>}</span></a>
    <span>{company.identity.ticker || '非上場'} · {companyContext.country}</span>
  </template>

  <template data-company-slot="company-identity" data-company-label={companyContext.name} data-has-content="true">
    <div class="evidence-company-context"><span data-company-order-label>--</span><strong aria-label={companyContext.accessibleName}>{companyContext.primaryName}{companyContext.secondaryName && <small>{companyContext.secondaryName}</small>}</strong></div>
    <div class="evidence-identity">
      <span>{company.identity.ticker || '非上場'} · {companyContext.country}</span>
      <span>{company.identity.primaryLayer}</span>
    </div>
    <dl class="evidence-cell-details" data-expanded-only>
      {company.identity.officialName && <div><dt>正式名称</dt><dd>{company.identity.officialName}</dd></div>}
      {company.identity.reading && <div><dt>読み</dt><dd>{company.identity.reading}</dd></div>}
      {company.identity.lastReviewed && <div><dt>最終確認</dt><dd>{company.identity.lastReviewed}</dd></div>}
    </dl>
  </template>

  {presentationDimensionIds.map(dimensionId => {
    const dimension = presentationFor(dimensionId);
    const typeGroups = claimTypeGroups(dimension.claims, dimension.relations);
    return <template
      data-company-slot={dimensionId}
      data-company-label={companyContext.name}
      data-has-content={String(dimension.hasContent)}
    >
      <div class="evidence-company-context"><span data-company-order-label>--</span><strong aria-label={companyContext.accessibleName}>{companyContext.primaryName}{companyContext.secondaryName && <small>{companyContext.secondaryName}</small>}</strong></div>
      {dimension.hasContent ? <>
        {(typeGroups.fact || typeGroups.company || typeGroups.analysis) && <div class="evidence-epistemic-notes">
          {typeGroups.fact && <span>事実</span>}
          {typeGroups.company && <span>会社見解</span>}
          {typeGroups.analysis && <span class="evidence-epistemic-analysis">Atlasの見方</span>}
        </div>}
        {dimension.sections.map((section, sectionIndex) => {
          const displayedRelations = relationsForDisplay(section.relations);
          const usesClaimBackedPositionProjection = dimensionId === 'ai-role'
            && section.dimensionId === 'value-chain-position'
            && !displayedRelations.some(entry => entry.relation.relationType === 'POSITIONED_IN')
            && section.claims.length > 0;
          const relationProductIds = new Set(displayedRelations
            .filter(entry => entry.relation.relationType === 'PRODUCES')
            .map(entry => entry.relation.objectId));
          const claimOnlyProducts = section.displayProducts.filter(item => !relationProductIds.has(item.canonicalId));
          const claimOnlyProductEntries = claimOnlyProducts.map(item => {
            if (item.groundingIds.length !== 1) {
              throw new Error(`Company Compare Product entry must resolve one grounding Claim: ${company.identity.id}:${item.canonicalId}`);
            }
            const groundingClaim = section.claims.find(entry => entry.claim.id === item.groundingIds[0]);
            if (!groundingClaim) {
              throw new Error(`Company Compare Product entry grounding Claim is unresolved: ${company.identity.id}:${item.canonicalId}:${item.groundingIds[0]}`);
            }
            const markerSourceNumbers = [...new Set(groundingClaim.bindings
              .map(binding => sourceNumberById[binding.sourceId])
              .filter(Boolean))];
            if (markerSourceNumbers.length === 0) {
              throw new Error(`Company Compare Product entry has no numbered Evidence source: ${company.identity.id}:${item.canonicalId}`);
            }
            return {
              item,
              groundingClaim,
              markerLabel: markerSourceNumbers.join(', '),
            };
          });
          const productPortfolioSummary = dimensionId === 'key-products'
            ? resolveCompanyCompareProductPortfolioSummary(
                company.identity.id,
                new Set(section.claims.map(entry => entry.claim.id)),
              )
            : null;
          const usesGroupLevelProductEvidence = Boolean(
            productPortfolioSummary
            && relationProductIds.size === 0
            && claimOnlyProductEntries.length > 0,
          );
          const summaryClaimIds = new Set(selectCompareSummaryClaimIds(dimensionId, sectionIndex, section.claims.map(entry => entry.claim), displayedRelations.map(entry => entry.relation)));
          const summaryRelationIds = new Set(selectCompareSummaryRelationIds(dimensionId, sectionIndex, displayedRelations.map(entry => entry.relation)));
          return <div class:list={['evidence-dimension-subsection', { 'evidence-dimension-subsection-secondary': sectionIndex > 0 }]}>
            {sectionIndex > 0 && <h3 class="evidence-subsection-title">{section.label}</h3>}
            {dimensionId === 'technology-moat' && section.displayTechnologies.length > 0 && <ul class="evidence-canonical-list" aria-label="関連技術">
              {section.displayTechnologies.map((item, itemIndex) => <li data-canonical-id={item.canonicalId} data-grounding-ids={item.groundingIds.join(',')} data-summary={itemIndex < 3 ? 'show' : 'hide'}>{item.label}</li>)}
            </ul>}
            {section.claims.map(entry => {
              const isProductPortfolioSummary = productPortfolioSummary?.groundingId === entry.claim.id;
              const freshness = deriveEvidenceFreshness(entry.claim.nextReview);
              return <div
                class:list={['evidence-claim-entry', {
                  'evidence-position-entry': usesClaimBackedPositionProjection,
                  'evidence-product-portfolio-summary': isProductPortfolioSummary,
                }]}
                data-claim-id={entry.claim.id}
                data-claim-priority={entry.claim.priority}
                data-display-grounding-ids={entry.display.groundingIds.join(',')}
                data-product-portfolio-summary={isProductPortfolioSummary ? 'true' : undefined}
                data-summary-visible={isProductPortfolioSummary ? String(productPortfolioSummary.summaryVisible) : undefined}
                data-expanded-visible={isProductPortfolioSummary ? String(productPortfolioSummary.expandedVisible) : undefined}
                data-summary={isProductPortfolioSummary
                  ? (usesGroupLevelProductEvidence ? 'show' : 'hide')
                  : (summaryClaimIds.has(entry.claim.id) ? 'show' : 'hide')}
              >
                {usesClaimBackedPositionProjection && <div class="evidence-claim-projection-context" data-expanded-only>
                  <h3>{entry.display.title}</h3>
                  <p class="claim-statement">{entry.display.statement}</p>
                </div>}
                <CompanyCompareEvidenceClaim
                  claim={entry.claim}
                  evidence={entry.bindings}
                  sources={entry.sources}
                  sourceNumberById={sourceNumberById}
                  compact
                  suppressTypeLabel
                  displayTitle={usesClaimBackedPositionProjection
                    ? '半導体製造'
                    : isProductPortfolioSummary
                      ? productPortfolioSummary.title
                      : entry.display.title}
                  displayStatement={usesClaimBackedPositionProjection
                    ? ''
                    : isProductPortfolioSummary
                      ? productPortfolioSummary.body
                      : entry.display.statement}
                  variant={usesClaimBackedPositionProjection ? 'list' : 'standard'}
                  additionalMetadata={[
                    { label: '主張区分', value: entry.claim.claimType },
                    { label: '最終検証', value: entry.claim.lastVerified ?? '未記録' },
                    { label: '対象範囲', value: '企業全体' },
                  ]}
                />
                {usesClaimBackedPositionProjection && <dl class="evidence-relation-meta" data-expanded-only>
                  <div><dt>対象範囲</dt><dd>企業全体</dd></div>
                  <div><dt>更新状況</dt><dd>{freshnessLabels[freshness.key] ?? freshness.label}</dd></div>
                </dl>}
              </div>;
            })}
            {dimensionId === 'key-products' && claimOnlyProductEntries.length > 0 && <div class="evidence-claim-backed-product-list" aria-label="製品の役割">
              {claimOnlyProductEntries.map(({ item, groundingClaim, markerLabel }) => <div
                class="evidence-relation-entry evidence-product-entry evidence-claim-backed-product-entry"
                data-canonical-id={item.canonicalId}
                data-display-grounding-ids={item.groundingIds.join(',')}
                data-product-grounding-id={groundingClaim.claim.id}
                data-summary="show"
              >
                <article class="pilot-claim pilot-claim-list pilot-claim-compact" aria-label={`事実: ${claimBackedProductLabel(item.canonicalId, item.label)}`}>
                  <p class="claim-statement claim-statement-list"><strong>{claimBackedProductLabel(item.canonicalId, item.label)}</strong><button
                    class="evidence-marker"
                    type="button"
                    data-evidence-open={`evidence-${groundingClaim.claim.id}`}
                    aria-haspopup="dialog"
                    aria-controls={`evidence-${groundingClaim.claim.id}`}
                    aria-expanded="false"
                    aria-label={`${claimBackedProductLabel(item.canonicalId, item.label)}の根拠 ${groundingClaim.bindings.length}件`}
                  ><span aria-hidden="true">[{markerLabel}]</span></button></p>
                  <p class="evidence-product-description" data-expanded-only data-product-description={item.canonicalId}>{item.description}</p>
                </article>
              </div>)}
            </div>}
            {displayedRelations.map(entry => {
              const relationClaim = relationAsClaim(entry);
              return <div class:list={['evidence-relation-entry', { 'evidence-position-entry': entry.relation.relationType === 'POSITIONED_IN' }]} data-relation-id={entry.relation.relationId} data-canonical-id={entry.relation.objectId} data-display-grounding-ids={entry.display.groundingIds.join(',')} data-summary={summaryRelationIds.has(entry.relation.relationId) ? 'show' : 'hide'}>
                <CompanyCompareEvidenceClaim
                  claim={relationClaim}
                  evidence={entry.bindings}
                  sources={entry.sources}
                  sourceNumberById={sourceNumberById}
                  compact
                  suppressTypeLabel
                  displayTitle={entry.display.title}
                  displayStatement={entry.display.statement}
                  variant={['PRODUCES', 'POSITIONED_IN'].includes(entry.relation.relationType) ? 'list' : 'standard'}
                  productDescription={entry.productDescription ?? undefined}
                  drawerKicker="関係の根拠"
                  drawerTitle="関係の根拠"
                  provenanceTypeLabel={`Relation: ${entry.relation.relationType}`}
                  verificationPresentation={entry.verification}
                  priorityLabel="重要度"
                  freshnessOverride={{
                    key: entry.relation.freshnessStatus,
                    label: freshnessLabels[entry.relation.freshnessStatus] ?? entry.relation.freshnessStatus,
                  }}
                  additionalMetadata={[
                    { label: '関係種別', value: entry.relation.relationType },
                    { label: '根拠の対応', value: `${entry.verification.support}（直接支持）` },
                    { label: '対象範囲', value: entry.scopeLabel },
                    { label: '根拠箇所の確認日', value: entry.verification.locatorCheckedAt },
                    { label: '最終検証', value: entry.relation.lastVerified ?? '未記録' },
                  ]}
                />
                <dl class="evidence-relation-meta" data-expanded-only>
                  <div><dt>対象範囲</dt><dd>{entry.scopeLabel}</dd></div>
                  <div><dt>更新状況</dt><dd>{freshnessLabels[entry.relation.freshnessStatus] ?? entry.relation.freshnessStatus}</dd></div>
                </dl>
              </div>;
            })}
          </div>;
        })}
      </> : <p class="evidence-missing">{missingLabels[dimension.missingState] ?? '未収録'}</p>}
    </template>;
  })}

  <template
    data-company-slot="financial"
    data-company-label={companyContext.name}
    data-has-content={String(Boolean(operatingMarginReference?.displayValue))}
  >
    <div class="evidence-company-context"><span data-company-order-label>--</span><strong aria-label={companyContext.accessibleName}>{companyContext.primaryName}{companyContext.secondaryName && <small>{companyContext.secondaryName}</small>}</strong></div>
    {operatingMarginReference?.displayValue ? <div class="evidence-financial-value">
      <span>営業利益率</span>
      <strong>{operatingMarginReference.displayValue}</strong>
      <small>{operatingMarginReference.periodLabel} · {operatingMarginReference.accountingBasis}</small>
      {operatingMarginReference.source && <a class="evidence-source-link" href={operatingMarginReference.source.url} target="_blank" rel="noreferrer">一次資料を開く ↗</a>}
    </div> : <p class="evidence-missing">{operatingMarginReference?.availability ?? '未収録'}</p>}
  </template>

  <template data-company-slot="expanded-financial">
    <section data-company-id={company.identity.id} class="evidence-financial-company">
      <h4>{companyContext.name}</h4>
      <p class="financial-basis">会計基準：{company.expandedFinancialPresentation.accountingBasisLabel}</p>
      <div class="evidence-financial-scroll" tabindex="0" aria-label={`${companyContext.accessibleName}の財務履歴`}>
        <table>
          <thead><tr>
            <th class="period" scope="col">期間</th>
            <th class="num" scope="col">売上高<br />（{company.expandedFinancialPresentation.amountUnitLabel}）</th>
            <th class="num" scope="col">営業利益<br />（{company.expandedFinancialPresentation.amountUnitLabel}）</th>
            <th class="num" scope="col">営業利益率</th>
            <th class="num" scope="col">フリーキャッシュフロー<br />（{company.expandedFinancialPresentation.amountUnitLabel}）</th>
            <th class="num" scope="col">設備投資<br />（{company.expandedFinancialPresentation.amountUnitLabel}）</th>
            <th class="num" scope="col">ROIC</th>
            <th scope="col">出典</th>
          </tr></thead>
          <tbody>{company.expandedFinancial.map(record => <tr>
            <th class="period" scope="row">{record.displayPeriodLabel}</th>
            {['revenue', 'operatingProfit', 'operatingMargin', 'freeCashFlow', 'capex', 'roic'].map(metricId => {
              const metric = financialMetric(record, metricId);
              return metric?.displayValue
                ? <td class="num">{metric.displayValue}</td>
                : <td class="missing">未収録</td>;
            })}
            <td><a class="evidence-source-link" href={record.source.url} target="_blank" rel="noreferrer">一次資料 ↗</a></td>
          </tr>)}</tbody>
        </table>
      </div>
    </section>
  </template>

  <template data-company-slot="evidence-trace">
    <div data-company-id={company.identity.id}>
      <strong>{companyContext.name}</strong>
      <span>主張の根拠 {company.evidenceTrace.companyEvidenceBindingIds.length}件 · 関係の根拠 {company.evidenceTrace.relationEvidenceBindingIds.length}件</span>
    </div>
  </template>
</div>
