---
import { withBase } from '../lib/paths';
const path = Astro.url.pathname;
const nav = [
  ['全体マップ','atlas/'],
  ['企業一覧','companies/'],
  ['企業比較','compare/'],
  ['全文検索','search/'],
  ['データ基準','methodology/'],
];
---
<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand-main">AI Infrastructure Atlas</span>
      <span class="brand-sub">半導体・AIインフラ企業データベース</span>
    </a>
    <nav class="nav" aria-label="主要ナビゲーション">
      {nav.map(([label, href]) => {
        const target = withBase(href);
        const active = path.startsWith(target);
        return <a href={target} aria-current={active ? 'page' : undefined}>{label}</a>;
      })}
    </nav>
  </div>
</header>
