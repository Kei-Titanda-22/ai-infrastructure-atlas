---
const { name, score } = Astro.props;
---
<div class="score-card">
  <div class="score-top">
    <div class="score-heading">
      <span class="score-name">{name}</span>
      <span class="score-direction">{score.direction}</span>
    </div>
    <span class="score-value">{score.value}<small style="font-size:11px;color:var(--muted)">/5</small></span>
  </div>
  <div class="score-track" aria-hidden="true"><span style={`width:${score.value * 20}%`}></span></div>
  <p>{score.rationale}</p>
</div>
