---
import '../styles/global.css';
import '../styles/data-evidence-v05.css';
import '../styles/v02-expansion.css';
import '../styles/financial-v04.css';
import financialHistory from '../data/financial-history.json';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  indexable?: boolean;
}
const {
  title = 'AI Infrastructure Atlas',
  description = '半導体・AIインフラ企業を横断的に調査・比較する個人用リサーチデータベース',
  indexable = false,
} = Astro.props;
const pageTitle = title === 'AI Infrastructure Atlas' ? title : `${title} | AI Infrastructure Atlas`;
const financialCompanyIds = [...new Set(financialHistory.map(record => record.companyId))].join(',');
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#F6F6F3" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Header />
    <main class="site-main" data-pagefind-body={indexable || undefined} data-financial-company-ids={financialCompanyIds}>
      <slot />
    </main>
    <Footer />
    <script is:inline>
      const companyToc = document.querySelector('.company-toc');
      const advantagesSection = document.querySelector('#advantages');
      if (companyToc && advantagesSection && !companyToc.querySelector('a[href="#advantages"]')) {
        const link = document.createElement('a');
        link.href = '#advantages';
        link.textContent = '競争優位';
        const facilitiesLink = companyToc.querySelector('a[href="#facilities"]');
        companyToc.insertBefore(link, facilitiesLink || null);
      }

      const siteMain = document.querySelector('.site-main');
      const financialIds = new Set((siteMain?.getAttribute('data-financial-company-ids') || '').split(',').filter(Boolean));
      const pathname = location.pathname;
      const companyMarker = '/companies/';
      const companyMarkerIndex = pathname.indexOf(companyMarker);
      const basePrefix = companyMarkerIndex >= 0 ? pathname.slice(0, companyMarkerIndex + 1) : pathname.replace(/[^/]*$/, '');
      const companyMatch = pathname.match(/\/companies\/([^/]+)\/?$/);

      if (companyMatch) {
        const companyId = decodeURIComponent(companyMatch[1]);
        const financialSection = document.querySelector('#financials');
        if (financialIds.has(companyId) && financialSection && !financialSection.querySelector('[data-financial-history-jump]')) {
          const jump = document.createElement('p');
          jump.className = 'section-intro';
          jump.setAttribute('data-financial-history-jump', '');
          const anchor = document.createElement('a');
          anchor.className = 'text-link';
          anchor.href = `${basePrefix}financials/?company=${encodeURIComponent(companyId)}`;
          anchor.textContent = '四半期・通期の決算推移を見る →';
          jump.append(anchor);
          const intro = financialSection.querySelector('.section-intro');
          if (intro) intro.insertAdjacentElement('afterend', jump);
          else financialSection.querySelector('h2')?.insertAdjacentElement('afterend', jump);
        }
      }

      const attachCompareFinancialLinks = () => {
        const compareHead = document.querySelector('#compare-head');
        if (!compareHead) return;
        compareHead.querySelectorAll('a.compare-company-head').forEach(companyLink => {
          const href = companyLink.getAttribute('href') || '';
          const match = href.match(/\/companies\/([^/]+)\/?/);
          if (!match) return;
          const companyId = decodeURIComponent(match[1]);
          const parent = companyLink.parentElement;
          if (!parent || !financialIds.has(companyId) || parent.querySelector('[data-compare-financial-link]')) return;
          const anchor = document.createElement('a');
          anchor.className = 'text-link compare-company-sub';
          anchor.setAttribute('data-compare-financial-link', '');
          anchor.href = `${basePrefix}financials/?company=${encodeURIComponent(companyId)}`;
          anchor.textContent = '決算履歴 →';
          parent.append(anchor);
        });
      };

      const compareHead = document.querySelector('#compare-head');
      if (compareHead) {
        attachCompareFinancialLinks();
        new MutationObserver(attachCompareFinancialLinks).observe(compareHead, { childList: true, subtree: true });
      }
    </script>
  </body>
</html>
