{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kei-titanda-22.github.io/ai-infrastructure-atlas/schemas/relation-evidence-binding-v01.json",
  "title": "Atlas Relation Evidence Binding v0.1",
  "type": "array",
  "items": { "$ref": "#/$defs/binding" },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "page": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "heading": { "type": "string", "minLength": 1 },
        "table": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "anchor": { "type": "string", "minLength": 1 },
        "quotedLabel": { "type": "string", "minLength": 1 }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "relationId", "sourceId", "support", "locator", "lastChecked"],
      "properties": {
        "id": { "type": "string", "pattern": "^rel-evidence-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "relationId": { "type": "string", "pattern": "^rel-[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "sourceId": { "type": "string", "minLength": 1 },
        "support": { "enum": ["supports", "context", "contradicts"] },
        "locator": { "$ref": "#/$defs/locator" },
        "lastChecked": { "$ref": "#/$defs/date" },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
