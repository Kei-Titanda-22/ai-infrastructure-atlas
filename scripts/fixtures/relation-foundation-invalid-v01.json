  },
  {
    "name": "duplicate logical binding",
    "operation": "duplicateLogicalBinding",
    "expectedError": "duplicate Relation/Source/Locator Binding"
  },
  {
    "name": "unstable Relation order",
    "operation": "unstableRelationOrder",
    "expectedError": "Relation records must use stable relationId ordering"
  },
  {
    "name": "unstable Binding order",
    "operation": "unstableBindingOrder",
    "expectedError": "Relation Evidence Binding records must use stable ID ordering"
  },
  {
    "name": "invalid supersededBy signature",
    "operation": "invalidSupersededSignature",
    "expectedError": "supersededBy must preserve logical endpoint and scope"
  },
  {
    "name": "unknown scope ID",
    "operation": "updateScope",
    "values": { "productIds": ["product-category-unknown"] },
    "expectedError": "scope.productIds contains unknown or invalid IDs"
