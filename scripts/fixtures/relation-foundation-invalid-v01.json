[
  {
    "name": "derived authoring field",
    "operation": "updateRelation",
    "values": { "sourceIds": [] },
    "expectedError": "authoring Relation contains derived fields"
  },
  {
    "name": "deferred type",
    "operation": "updateRelation",
    "values": { "relationType": "SUBSTITUTES" },
    "expectedError": "deferred Relation type"
  },
  {
    "name": "unknown type",
    "operation": "updateRelation",
    "values": { "relationType": "UNKNOWN_RELATION" },
    "expectedError": "unknown Relation type"
  },
  {
    "name": "endpoint kind mismatch",
    "operation": "updateRelation",
    "values": { "objectType": "company", "objectId": "company-b" },
    "expectedError": "endpoint kinds are incompatible"
  },
  {
    "name": "unknown endpoint",
    "operation": "updateRelation",
    "values": { "objectId": "product-category-unknown" },
    "expectedError": "unknown object endpoint"
  },
  {
    "name": "business unit forbidden",
    "operation": "updateScope",
    "values": { "businessUnit": "Accelerated Computing" },
    "expectedError": "scope.businessUnit must be null"
  },
  {
    "name": "evidence free",
    "operation": "removeBindings",
    "expectedError": "requires a direct supports Binding"
  },
  {
    "name": "context only",
    "operation": "updateBinding",
    "values": { "support": "context" },
    "expectedError": "requires a direct supports Binding"
  },
  {
    "name": "empty locator",
    "operation": "updateBinding",
    "values": { "locator": {} },
    "expectedError": "structured Locator is required"
  },
  {
    "name": "unknown source",
    "operation": "updateBinding",
    "values": { "sourceId": "source-unknown" },
    "expectedError": "unknown Shared Source"
  },
  {
    "name": "missing as-of date",
    "operation": "updateRelation",
    "values": { "asOf": null },
    "expectedError": "asOf must be an ISO date"
  },
  {
    "name": "self reference",
    "operation": "updateRelation",
    "values": { "relationType": "SUPPLIES_TO", "objectType": "company", "objectId": "company-a" },
    "expectedError": "prohibited self-reference"
  },
  {
    "name": "symmetric endpoint order",
    "operation": "updateRelation",
    "values": { "subjectId": "company-b", "relationType": "COMPETES_WITH", "objectType": "company", "objectId": "company-a" },
    "expectedError": "lexicographic canonical order"
  },
  {
    "name": "guarded relation without scope",
    "operation": "updateRelation",
    "values": { "subjectType": "product", "subjectId": "product-category-gpu", "relationType": "ENABLES", "objectType": "technology", "objectId": "technology-accelerated-computing-architecture" },
    "expectedError": "guarded Relation requires at least one scope dimension"
  },
  {
    "name": "binding unknown relation",
    "operation": "updateBinding",
    "values": { "relationId": "rel-unknown-relation" },
    "expectedError": "unknown Relation"
  },
  {
    "name": "duplicate logical relation",
    "operation": "duplicateRelation",
    "expectedError": "duplicate logical Relation with overlapping validity"
  }
]
